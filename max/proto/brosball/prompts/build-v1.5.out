}
function runTick(){game.clock+=DT;
 for(const p of fx){p.life-=DT;p.x+=p.vx*DT;p.y+=p.vy*DT;p.vy+=300*DT;}fx=fx.filter(p=>p.life>0);shake=Math.max(0,shake-DT*28);flash=Math.max(0,flash-DT);
 if(wantedPrompt())return;if(loopRow&&loopRow.date!==dateKey()){endLoop(true);beginLoop();}
 const active=rules.phase!=='reset'&&rules.phase!=='end';if(active){game.playTime+=DT;if(recording()&&validationActive())daily().active+=DT;}
 present(RULES.tick(rules));trail.push(point(rules.ball.x,rules.ball.y));if(trail.length>8)trail.shift();
 if(recording()&&game.clock-lastSave>=1){lastSave=game.clock;save();}}
function advance(seconds){if(!Number.isFinite(seconds)||seconds<0)throw Error('step: 유한한 0 이상 초');accumulator+=seconds;while(accumulator+1e-9>=DT){runTick();accumulator-=DT;}}
function step(seconds=0){advance(seconds);render();return state();}
function label(text,x,y,size=40,color='#fff3d6'){ctx.fillStyle=color;ctx.font=`bold ${size}px system-ui`;ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(String(text),x,y);}
function panel(box,text,size=40){ctx.fillStyle='#1d2b45';ctx.strokeStyle='#5c92b5';ctx.lineWidth=5;ctx.beginPath();ctx.roundRect(box.x-box.w/2,box.y-box.h/2,box.w,box.h,28);ctx.fill();ctx.stroke();if(text)label(text,box.x,box.y,size);}
function ring(v,color,r){ctx.strokeStyle=color;ctx.lineWidth=6;ctx.beginPath();ctx.ellipse(v.x,v.y,r,r*.45,0,0,Math.PI*2);ctx.stroke();}
