   273	function state(){return copy({proto:PROTO,build:BUILD,...game,...rules,rules,loop:loopRow,geometry:geom,coreLoop,validation:archive.validation,records:archive,checkResult});}
   274	function botState(seed,level){const s=RULES.init(DATA,seed);s.config.ai.level=level;return s;}
   275	function chooseBot(s,mode){if(mode==='search'){const cmd=aiPick(s,3);s.rng=cmd.nextRng;return cmd;}return randomPick(s);}
   276	function validateBot(mode){if(!['random','search'].includes(mode))throw Error('mode: random | search');}
   277	function bot(seconds,mode='random'){validateBot(mode);if(!Number.isFinite(seconds)||seconds<=0)throw Error('bot: 유한한 양수 초');
   278	 const s=botState(2463534242,DATA.ai.level),ticks=Math.ceil(seconds*60);let inputs=0,wins=0,combos=0;
   279	 for(let i=0;i<ticks;i++){if(s.phase==='aim'&&s.team===0){RULES.apply(s,chooseBot(s,mode));inputs++;}for(const e of RULES.tick(s).events){if(e.k==='combo')combos++;if(e.k==='matchEnd'&&e.winner===0)wins++;}}
   280	 return {seconds,mode,inputs,wins,combos,changed:s.turns>0,metrics:{turns:s.turns},rules:copy(s)};
   281	}
   282	function sim(games,mode='random',level=3){validateBot(mode);if(!Number.isInteger(games)||games<1||!Number.isInteger(level)||level<1||level>3)throw Error('sim: games 양의 정수, level 1~3');
   283	 let wins=0,totalTicks=0,combos=0,goals=0,saves=0,unfinished=0;const flicks=[0,0,0];
   284	 for(let n=0;n<games;n++){const s=botState((2463534242+n*104729)>>>0,level);let finished=false;
   285	  for(let t=0;t<72000;t++){if(s.phase==='aim'&&s.team===0){const cmd=chooseBot(s,mode);flicks[cmd.who]++;RULES.apply(s,cmd);}const es=RULES.tick(s).events;
   286	   goals+=es.filter(e=>e.k==='goal').length;saves+=es.filter(e=>e.k==='save').length;
   287	   combos+=es.filter(e=>e.k==='combo').length;
   288	   const ended=es.find(e=>e.k==='matchEnd');if(ended){wins+=ended.winner===0?1:0;totalTicks+=s.tick;finished=true;break;}
   289	  }if(!finished){unfinished++;totalTicks+=s.tick;}
   290	 }
   291	 return {winRate:wins/games*100,avgSeconds:totalTicks/games/60,combosPerGame:combos/games,goalsPerGame:goals/games,savesPerGame:saves/games,flickShare:flicks.map(v=>v/Math.max(1,flicks.reduce((a,b)=>a+b,0))),unfinished};
