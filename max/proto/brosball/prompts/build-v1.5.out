function aiPick(s,level){const rand={rng:s.rng,config:s.config},candidates=[],a=s.config.ai;
 for(let who=0;who<3;who++)for(const dir of a.directions){const pull=(a.pullBase+rngInt(rand,a.pullRange))*a.pullStep,cmd={k:'flick',who,dx:dir[0]/a.directionScale*pull,dy:dir[1]/a.directionScale*pull};
  const candidate={cmd,score:aiScore(s,simulate(s,cmd)),order:candidates.length};let at=candidates.length;
  while(at>0&&candidates[at-1].score<candidate.score)at--;candidates.splice(at,0,candidate);}
 const index=rngInt(rand,a.counts[level-1]),result=copyState(candidates[index].cmd);result.nextRng=rand.rng;result.candidates=candidates.length;return result;
}
function randomPick(s){const a=s.config.ai,who=rngInt(s,3),dir=a.directions[rngInt(s,a.directions.length)],pull=(a.pullBase+rngInt(s,a.pullRange))*a.pullStep;return {k:'flick',who,dx:dir[0]/a.directionScale*pull,dy:dir[1]/a.directionScale*pull};}
function init(data,seed){const config={physics:data.physics,players:data.players,ai:data.ai,league:data.league,keeper:data.keeper,coins:data.coins,rng:data.rng};
 const s={config:copyState(config),tick:0,rng:(seed>>>0)||data.rng.seed,round:1,jobs:[],score:[0,0],turns:0,team:0,phase:'aim',opponent:0,stickers:[],leagueComplete:false,suddenDeath:false,winner:-1,combos:0,coins:0,pending:null};
 for(const team of data.league)s.stickers.push(false);resetPitch(s);return s;
}
function apply(s,cmd){const out=flick(s,cmd);if(out.events.length&&Number.isInteger(cmd.nextRng))s.rng=cmd.nextRng;return out;}
function tick(s){s.tick++;const events=[],due=[],later=[];
 for(const job of s.jobs){if(job.at<=s.tick)due.push(job);else later.push(job);}s.jobs=later;
 for(const job of due){if(job.k==='aiFlick'&&s.phase==='aiThink'){s.phase='aim';appendEvents(events,flick(s,s.pending).events);s.pending=null;}
  else if(job.k==='reset'&&s.phase==='reset'){resetPitch(s);enterAim(s,events);events.push({k:'reset'});}
  else if(job.k==='nextMatch'&&s.phase==='end'){s.score=[0,0];s.combos=0;s.coins=0;s.turns=0;s.team=0;s.suddenDeath=false;s.winner=-1;s.round++;resetPitch(s);enterAim(s,events);events.push({k:'matchStart'});}
 }
 if(s.phase==='settle'){const out=physicsTick(s);appendEvents(events,out.events);if(s.phase==='settle'&&out.settled)nextTurn(s,events);}
 return {events};
}
'''+'const RULES={init,apply,tick};\\n'
