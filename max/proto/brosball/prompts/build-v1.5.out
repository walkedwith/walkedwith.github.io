   194	function sound(combo=false,short=false){if(inspecting||checkMode||statsMode)return;try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();audioCtx.resume();
   195	 for(let i=0;i<(combo?3:1);i++){const osc=audioCtx.createOscillator(),gain=audioCtx.createGain(),t=audioCtx.currentTime+i*.08;osc.frequency.setValueAtTime(440*(1+i*.5),t);gain.gain.setValueAtTime(.0001,t);gain.gain.exponentialRampToValueAtTime(.12,t+.01);gain.gain.exponentialRampToValueAtTime(.0001,t+(short ? .07 : .2));osc.connect(gain);gain.connect(audioCtx.destination);osc.start(t);osc.stop(t+(short ? .09 : .22));}}catch(_){} }
