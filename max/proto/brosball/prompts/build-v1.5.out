}
function simulate(s,cmd,limit=null){const p=s.config.physics;if(limit===null)limit=p.simulateTicks;const clone=copyState(s);clone.phase='aim';clone.jobs=[];const events=flick(clone,cmd).events,trace=[];let ticks=0;
