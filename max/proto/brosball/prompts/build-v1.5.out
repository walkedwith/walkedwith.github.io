  if(out.settled||clone.phase!=='settle')break;
 }
 return {s:clone,events,trace,ticks};
}
function aiScore(before,out){const team=before.team,enemy=1-team,p=before.config.physics,a=before.config.ai,ball=out.s.ball,target=team===1?p.height:0;
 let value=Math.hypot(before.ball.x-p.width/2,before.ball.y-target)-Math.hypot(ball.x-p.width/2,ball.y-target),mate=false,combo=false,nearMate=false,nearEnemy=false;
