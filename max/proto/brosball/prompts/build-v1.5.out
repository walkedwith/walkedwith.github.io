/bin/zsh -lc "cat > /private/tmp/bros_tests.txt <<'EOF'
function portRuntime(){return runtime(430,932,'?check',0,0,{}, {source:source.replace('window.T={state,step,input,load,assets,check,bot,sim};','window.T={state,step,input,load,assets,check,bot,sim,canon,transport,stateHash,fnv,DATA_HASH,RULES,aiPick,recordEvents};')});}
function goldenMatch(seed){
 const r=portRuntime(),api=r.T,s=api.RULES.init(data,seed),log={v:1,build:'brosball-v1',dataHash:api.DATA_HASH,seed,start:null,cmds:[],endTick:0,events:[]},hashPerTurn=[],checkpoints=[];
 let ended=false;
 for(let t=0;t<72000;t++){
  if(s.phase==='aim'&&s.team===0){const choice=api.aiPick(s,3),cmd={t:s.tick,seq:log.cmds.length,k:'flick',who:choice.who,dx:choice.dx,dy:choice.dy,nextRng:choice.nextRng};log.cmds.push(cmd);api.recordEvents(log,api.RULES.apply(s,cmd).events,s);checkpoints.push([s.tick,'cmd:'+cmd.seq,api.stateHash(s)]);hashPerTurn.push([s.tick,s.turns,api.stateHash(s)]);}
  const turns=s.turns,out=api.RULES.tick(s);api.recordEvents(log,out.events,s);
  if(turns"'!==s.turns)hashPerTurn.push([s.tick,s.turns,api.stateHash(s)]);
  if(s.tick%60===0)checkpoints.push([s.tick,'"'tick',api.stateHash(s)]);
  if(out.events.some(e=>e.k==='matchEnd')){ended=true;break;}
 }
 assert(ended,'golden match unfinished');log.endTick=s.tick;
 const finalHash=api.stateHash(s),replayed=api.replay(log);
 assert.equal(replayed.hash,finalHash);assert.equal(JSON.stringify(replayed.events),JSON.stringify(log.events));
 assert.equal(JSON.stringify(replayed.checkpoints),JSON.stringify(checkpoints));
 return {...log,checkpoints,hashPerTurn,finalHash,eventCount:log.events.length};
}
function goldenTest(){
 const folder=path.join(__dirname,'golden');if(process.argv.includes('--golden'))fs.mkdirSync(folder,{recursive:true});
 const seeds=[2463534242,2463638971,2463743700];
 for(const seed of seeds){const file=path.join(folder,'search-'+seed+'.json'),actual=goldenMatch(seed);
  if(process.argv.includes('--golden'))fs.writeFileSync(file,JSON.stringify(actual,null,2)+'\\n');
  assert.deepEqual(JSON.parse(JSON.stringify(actual)),JSON.parse(fs.readFileSync(file,'utf8')),'golden mismatch: '+seed);
 }
}
if(process.argv.includes('--golden')){test('골든 · 서로 다른 시드 search 3경기 생성·재생·검증',goldenTest);if(failed)process.exitCode=1;return;}
test('데이터 · RULES 매직 넘버 0 · GDScript 구조 · 함수 50줄 이하',()=>{
 const clean=rulesSource.replace(/\\/\\/["'^'"\\n]*|\\/\\*[\\s\\S]*?\\*\\//g,'');
 assert("'!/(?<!['"\\w.])(?:\\d+\\.?\\d*|\\.\\d+)(?:e[+-]?\\d+)?/gi.exec(''));
 const numbers=clean.match(/(?<"'!['"\\w.])(?:\\d+\\.?\\d*|\\.\\d+)(?:e[+-]?\\d+)?/gi)||[];
 assert.deepEqual(numbers.filter(n=>"'!/''^'"\\d"'$/.test(n)),[]);
 assert(!/=>|'"\\.\\.\\.|\\.(?:map|filter|reduce|sort|find|some|every)\\s*\\(/.test(clean));
 assert("'!rulesForbidden.test(clean));
 const allowed=['"'hypot','abs','min','max','floor'];for(const call of clean.matchAll(/Math\\.(\\w+)/g))assert(allowed.includes(call[1]));
 const functions=[...clean.matchAll(/function (\\w+)\\(/g)];for(let i=0;i<functions.length;i++){const end=functions[i+1]?.index??clean.length;assert(clean.slice(functions[i].index,end).split('\\n').length<=50,functions[i][1]);}
});
test('문구 · fillText/label/panel 한글 리터럴 0 · brosball 키만',()=>{
 assert("'!/(?:fillText|label|panel)'"\\(["'^'"\\n]*['\""'`][''^'"\\n]*[가-힣]/.test(source));
 for(const call of source.matchAll(/\\bS\\('(["'^'"']+)'/g)){assert(call[1].startsWith('brosball.'));assert(Object.hasOwn(data.strings,call[1]),call[1]);}
 for(const row of [...data.players,...data.league])assert(Object.hasOwn(data.strings,row.label));
});
test('canon · FNV · float64 무손실 수송',()=>{
 const {T}=portRuntime();assert.equal(T.fnv([]),'811c9dc5');assert.equal(T.fnv([97]),'e40c292c');
 assert.equal(T.canon({'2':2,'10':10,a:'\"\\\\'}),'{\"10\":10,\"2\":2,\"a\":\"\\\\\"\\\\\\\\\"}');
 assert.throws(()=>T.canon(.5));assert.throws(()=>T.canon('한'));assert.throws(()=>T.canon(2**53));
 assert.equal(T.canon(T.transport(.5)),'{\""'$f64":"3fe0000000000000"}'"');
 assert.notEqual(T.stateHash({x:.5}),T.stateHash({x:.5000000000000001}));
});
test('재생 · 저장 로그 해시/사건 순서 · 빈 틱 · 복수 명령 · 저장 거부 · 50경기',()=>{
 const r=runtime(430,932,'');play(r);r.T.input('flick',{who:0,dx:0,dy:-360});r.T.step(3);
 const log=JSON.parse(r.T.export()),before=JSON.stringify(r.T.state()),writes=r.writes(),actual=r.T.replay(log);
 assert.equal(actual.hash,r.T.hash());assert.equal(JSON.stringify(actual.events),JSON.stringify(log.events));assert.equal(JSON.stringify(r.T.state()),before);assert.equal(r.writes(),writes);
 const stored=JSON.parse(r.storage.proto_brosball_records).replays.at(-1);assert.equal(r.T.replay(stored).hash,r.T.hash());
 const q=runtime(430,932,'',0,0,{}, {storageThrows:true});play(q);q.T.input('flick',{who:1,dx:60,dy:0});q.T.step(.5);assert.equal(q.T.replay(q.T.export()).hash,q.T.hash());
 assert.throws(()=>r.T.replay({...log,dataHash:'bad'}));
 for(let i=0;i<53;i++)r.T.load(i+1);assert.equal(r.T.state().records.replays.length,50);
 const old=r.T.export();r.T.check();assert.equal(r.T.export(),old);
 const a=runtime();a.T.step(.5);assert.equal(a.T.replay(a.T.export()).hash,a.T.hash());
 const fixture=source.replace('window.T={state,step,input,load,assets,check,bot,sim};',"'`window.T={state,step,input,load,assets,check,bot,sim,finishFixture(){rules.phase='"'settle';rules.turns=20;rules.score=[1,0];beginReplay();}};"'`);
 const b=runtime(430,932,'"'',0,0,{}, {source:fixture});play(b);b.T.finishFixture();b.T.step(62/60);
 const logs=b.T.state().records.replays;assert(logs.length>=3);for(const entry of logs)assert.equal(JSON.stringify(b.T.replay(entry).events),JSON.stringify(entry.events));assert.equal(b.T.replay(b.T.export()).hash,b.T.hash());
});
test('골든 · search 3경기 hashPerTurn/최종/사건 순서 일치',goldenTest);
EOF
