function fnv(bytes){let h=2166136261;for(const byte of bytes)h=Math.imul(h"'^byte,16777619)>>>0;return h.toString(16).padStart(8,'"'0');}
function utf8(text){const bytes=[];for(const char of text){const n=char.codePointAt(0);if(n<128)bytes.push(n);else if(n<2048)bytes.push(192|(n>>6),128|(n&63));else if(n<65536)bytes.push(224|(n>>12),128|((n>>6)&63),128|(n&63));else bytes.push(240|(n>>18),128|((n>>12)&63),128|((n>>6)&63),128|(n&63));}return bytes;}
const DATA_HASH=fnv(utf8(document.getElementById('data').textContent));
function stateHash(s){return fnv(utf8(canon(transport(s))));}
function hash(){return stateHash(rules);}
function recordEvents(log,items,s=rules){for(const item of items)log.events.push({t:s.tick,seq:log.events.length,...copy(item)});}
function checkpoint(log,phase){log.checkpoints.push([rules.tick,phase,hash()]);}
function beginReplay(){
 matchLog={v:1,build:BUILD,dataHash:DATA_HASH,seed:DATA.rng.seed,start:copy(rules),cmds:[],endTick:rules.tick,checkpoints:[],events:[]};
 if(recording()){archive.replays.push(matchLog);archive.replays=archive.replays.slice(-50);save();}
}
function exportLog(){return JSON.stringify(matchLog);}
function replay(log){
 if(typeof log==='string')log=JSON.parse(log);
 if(log.dataHash"'!==DATA_HASH)throw Error('"'replay dataHash mismatch');
 const s=log.start?copy(log.start):RULES.init(DATA,log.seed),events=[],checkpoints=[];let at=0;
 while(s.tick<=log.endTick){
  while(at<log.cmds.length&&log.cmds[at].t===s.tick){const cmd=log.cmds[at++];recordEvents({events},RULES.apply(s,cmd).events,s);checkpoints.push([s.tick,'cmd:'+cmd.seq,stateHash(s)]);}
  if(s.tick===log.endTick)break;
  if(at<log.cmds.length&&log.cmds[at].t<s.tick)throw Error('replay command order');
  recordEvents({events},RULES.tick(s).events,s);
  if(s.tick%60===0)checkpoints.push([s.tick,'tick',stateHash(s)]);
 }
 if(at"'!==log.cmds.length)throw Error('"'replay command outside endTick');
 return {hash:stateHash(s),events,checkpoints};
}
