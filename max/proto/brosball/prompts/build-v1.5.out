 if(item.k==='bounceGoal'&&message!=='형제 콤보!')message='튕겨 골!';
 if(item.k==='bounce'){const v=point(item.x,item.y);burst(v.x,v.y,3);}
 if(item.k==='matchEnd'){if(item.winner===0)game.wins++;else game.losses++;if(loopRow){loopRow.failures+=item.winner===1?1:0;loopRow.success=item.winner===0;loopRow.complete=item.complete;}endLoop();message=item.complete?'우리동네 축구왕!':item.winner===0?'스티커 획득!':'한 번 더!';messageUntil=game.clock+1;burst(W/2,geom.league.y,36);}
 if(item.k==='matchStart'){payout=null;dives={};beginLoop();}
 }}
function hit(x,y,box){return !!box&&Math.abs(x-box.x)<=box.w/2&&Math.abs(y-box.y)<=box.h/2;}
function courtXY(x,y){return {x:(x-geom.court.x)/geom.court.scale,y:(y-geom.court.y)/geom.court.scale};}
function dragCommand(x,y){if(!pointer||pointer.who===null)return null;const v=courtXY(x,y);let dx=pointer.start.x-v.x,dy=pointer.start.y-v.y;const mag=Math.hypot(dx,dy);if(mag>360){dx*=360/mag;dy*=360/mag;}return {k:'flick',who:pointer.who,dx,dy};}
function input(kind,x=W/2,y=geom.H/2){if(!game||(statsMode&&!inspecting))return;
 if(kind==='wanted'){if(recording()&&typeof x==='boolean'){daily().wanted=x;save();render();}return;}
 if(kind==='validation'){if(recording()){archive.validation={build:BUILD,date:dateKey(),mode:'play'};for(const row of Object.values(archive.dates)){row.active=0;row.voluntary=0;}if(loopRow)loopRow.eligible=false;save();render();}return;}
 if(kind==='cancel'){pointer=null;return;}
 if(kind==='flick'){if(wantedPrompt())return;const result=RULES.apply(rules,{...x,k:'flick'});if(result.events.length){registerInput();present(result);}return;}
 if(kind==='tap'||kind==='down'){
  layout();for(const key of ['validation','yes','no'])if(hit(x,y,geom.buttons[key])){input(key==='validation'?'validation':'wanted',key==='yes');return;}
  if(kind==='tap'||hit(x,y,geom.recordStrip)||wantedPrompt()||rules.phase!=='aim'||rules.team!==0)return;
  const v=courtXY(x,y),who=rules.players.findIndex(p=>p.team===0&&Math.hypot(p.x-v.x,p.y-v.y)<=Math.max(p.r,22*W/canvas.getBoundingClientRect().width/geom.court.scale));
  if(who<0)return;pointer={who,start:v,x,y,cmd:null,preview:null};return;
 }
 if(kind==='move'&&pointer){pointer.x=x;pointer.y=y;pointer.cmd=dragCommand(x,y);pointer.preview=pointer.cmd?simulate(rules,pointer.cmd,60):null;return;}
 if(kind==='up'&&pointer){const cmd=dragCommand(x,y);pointer=null;if(cmd)input('flick',cmd);}
}
function runTick(){game.clock+=DT;
 for(const p of fx){p.life-=DT;p.x+=p.vx*DT;p.y+=p.vy*DT;p.vy+=300*DT;}fx=fx.filter(p=>p.life>0);shake=Math.max(0,shake-DT*28);flash=Math.max(0,flash-DT);
# 형제 골목 축구 (가칭) — 새 IP(형제) · 턴제 3:3 스포츠 대전
레퍼런스: 「Soccer Stars」(끌어서 튕기는 턴제 축구) · 「Into the Breach」(상대 수가 보이는 수 싸움) · 「이나즈마 일레븐」(동네 아이들 팀·필살 콤보)
수익 모델: **무료** — 대전 판돈(코인)·유니폼·공 꾸미기·시즌 패스. 시제품은 BM 없이 손맛만 판정(§6b 빠른 트랙).
화풍 기준 그림: `art/mock/key.png`(턴제 2:2 목업 한 장, 10-23) · 캐릭터 `../_concepts/dadmap/board-2-cast.png`. G2 목업 `art/mock/mock-g2.jpg`(네 상태).
경로: 형제×축구 후보 11개 중 사람 "턴제 2:2 목업 만들어봐" → "3명으로 하고 상대는 AI".

## 목표 (§3c-3a)
| 칸 | 내용 |
|---|---|
| 최종 목표 | 동네 다섯 팀을 다 이겨 「우리동네 축구왕」 현수막 주인이 된다 |
| 왜 계속하나 | 다음 상대 팀(잠긴 실루엣 + 이름) · 이긴 팀 스티커가 도감에 붙음 |
| 목표가 보이는 장치 | 경기 끝 화면의 동네 리그 띠(5칸, 이긴 팀 스티커·다음 팀 실루엣) + 경기 중 점수판 |

## 1. 판과 인원
- 코트: 세로 화면 전체. 논리 좌표 코트 폭 1080 × 길이 1500, 위가 상대 골(0), 아래가 내 골(1500). 골 폭 300.
- 우리 팀(아래, 노랑): **형**(강슛, 힘 1.3) · **동생**(빠름, 사거리 짧고 정확, 힘 0.8) · **다솜**(문방구 집 딸, 골키퍼, 막는 반지름 1.4).
- 상대 팀(위, 빨강): **쌍둥이 A**(공격) · **쌍둥이 B**(공격) · **공구**(골키퍼). **AI 가 둔다.**
- 선수는 반지름 48 원, 공은 반지름 24 원. 선수끼리·공과 선수는 원 충돌(탄성 0.6), 벽은 코트 경계(탄성 0.7), 골 폭 안으로 공 중심이 골선 넘으면 득점.

## 2. 턴
- **한 턴 = 한 쪽이 선수 하나를 튕긴다.** 내 턴 → 물리 정착(모든 속도 < 임계) → 상대 턴 → 정착 → 반복. 번갈아 둠(동시 턴은 안 만듦 — 뺀 것 §7).
- 튕기기: 선수 위에서 닿아 뒤로 끌었다 떼면 반대 방향으로 발사. 끈 길이 60~360 → 속도 6~36(논리 px/틱). 끈 길이 60 미만이면 취소.
- 선수는 공에 닿으면 공을 밀고, 선수끼리는 서로 밀쳐 낸다(태클). 공을 직접 끌 수 없다.
- 경기 = 각 팀 10턴(합 20) 또는 먼저 3골. 20턴 끝에 동점이면 다음 골 승.
- 득점 뒤 리셋: 선수 정위치, 공은 센터, 먹힌 팀이 먼저 둔다.

## 2a. 골키퍼 자동 막기 (10-23 사람 "1번 자동 막기")
- 골키퍼(다솜·공구)는 평소엔 다른 선수와 같은 말(튕길 수 있음). 추가로 **자기 골 앞 구역**(골선에서 깊이 220, 폭 520) 안에 있을 때만 자동으로 움직인다.
- 매 틱: 공이 자기 골 쪽으로 오고(속도의 골 방향 성분 > 0) 공과 골선 사이 거리가 600 안이면, 골키퍼가 공의 **예상 골선 통과 x** 를 향해 가로로 미끄러진다. 미끄러지는 속도 = `keeper.slide`(기본 3.5 px/틱) — 공 속도가 느릴수록 상대적으로 잘 막고, 강슛(속도 20 이상)이나 구석 슛은 못 따라간다. 구역 밖으로는 안 나간다.
- 막는 판정은 평소 원 충돌 그대로(반지름 1.4배). 막으면 공은 탄성으로 튕겨 나감, 이벤트 `save` — 연출 = 자세 3(다이빙) 12틱 + 「막았다!」 작은 글자.
- 자동 이동은 턴을 안 쓴다. 상대 턴이든 내 턴이든 양쪽 골키퍼 모두 같은 규칙.
- 밸런스 노브(data `keeper`): slide, 구역 깊이·폭, 반응 거리 600. 봇 지표: 경기당 총 골 2~5, 「막았다」 경기당 1~4.

## 3. 콤보(손맛 핵심)
- 내 턴에 **튕긴 선수가 아닌 같은 편 선수가 공에 닿은 뒤**, 상대 선수가 공에 닿지 않은 채 **같은 턴(정착 전)** 안에 골선을 넘으면 **「형제 콤보!」** — 연출 크게(§4b), 득점은 1 로 같음. (10-23 수정: 옛 "2틱 안" 은 불가능한 조건이었음.)
- **콤보 이득 = 코인(10-23 사람 "1번 코인"):** 경기 끝 코인 = 승 30 / 패 10 + 콤보 골마다 +15. 승패엔 영향 없음. 코인은 아직 쓸 곳 없음(두 번째 빌드 BM 자리에서 씀) — 경기 끝 보상 띠와 ?stats 누적에만 보인다. 봇 지표가 콤보 0.3/경기 아래면 다음 카드(골키퍼 무시)를 더한다.
- 공이 벽에 1번 이상 튕기고 들어가면 「튕겨 골!」 작은 연출.

## 4. 상대 AI (규칙 안, 결정적)
- 매 상대 턴: 후보 수 N=48개를 만든다 — 선수 셋 × 방향 16 × 힘 1 (힘은 후보마다 rngInt 로 6~36). 각 후보를 **규칙 시뮬레이션 복제본**(JSON 복제)으로 정착까지 돌려 점수 매김:
  - 내 골(아래) 득점 +1000 · 자책 −2000 · 공이 아래 골에 가까워진 거리 +1/px · 공이 우리 편 선수 반지름 100 안이면 +150 · 상대(플레이어) 선수가 공 반지름 120 안이면 −80 · 공구(골키퍼)가 골 앞 200 안에서 벗어나면 −120.
  - 난이도(data `ai.level`): 1 = 후보 중 상위 50% 안에서 rngInt 로 하나, 2 = 상위 20%, 3 = 최고. **기본 3**(10-23: 탐색 봇과 같은 세기 — 승률은 수로 맞추지 힘으로 맞추지 않는다).
- **양 팀 물리는 대칭.** 힘 배율은 역할표(힘·정확·골키퍼) 하나를 두 팀이 같이 쓴다. 상대에게만 힘을 더 주는 식의 비대칭 조정 금지(10-23 코덱스 시도 8번 기각).
- 시뮬레이션은 RULES 안의 순수 함수 `simulate(s, cmd)` 로 — 연출 없음, 틱 상한 600.

## 5. 코어 루프 (§0a)
| 칸 | 내용 |
|---|---|
| 본다 | 코트 전체 · 여섯 선수 · 공 · 점수판 · 남은 턴 · 내 턴 표시(노란 링) |
| 한다 | 선수 하나를 뒤로 끌었다 뗌(닿음→뗌 한 번) · 끄는 동안 예상 궤적 점선(첫 충돌까지) |
| 받는다 | 공이 굴러 결과가 보임 · 득점 시 입자·흔들림·빛·소리 · 콤보면 큰 글자 |
| 실패 | 자책 · 상대 득점 · 20턴 패배 → 바로 재경기(같은 상대) |
| 다시 | 경기 끝 → 리그 띠에 스티커 → 다음 상대 바로 |
| 보기 | 「형제 콤보!」 득점 · 현수막 획득 |
| 한 바퀴 | 한 경기 2~4분 |
| 이벤트 | 루프 시작=경기 시작 · 입력 한 번=튕김 · 성공=승 · 실패=패 · 끝=리그 완주 |

## 6. 동기·BM (§0b)
| 칸 | 내용 |
|---|---|
| 주 동기 | 숙달(각도·힘·콤보) |
| 보조 동기 | 진척(리그 5팀) · 수집(팀 스티커) |
| 아쉬움 자리 | 1점 차 패배 · 콤보 직전 골대 맞음 |
| BM 자리 | (시제품 제외) 재경기 버프 광고 · 꾸미기 |
| 하루 첫 접속 이유 | (시제품 제외) 일일 상대 |
| 소셜 (§0c) | (시제품 제외) 비동기 대결 — 남의 수를 녹화해 상대로 |

## 7. 빼는 것 (시제품)
동시 턴·비동기 대전·BM·소셜·선수 수집(셋째 자리 고정 다솜)·필살기·유니폼·날씨·리그 5팀 중 상대 그림은 한 팀(쌍둥이)만 — 리그 띠는 이름·색만 바꿔 같은 그림 재사용.

## 페이스 목표 (§6 페이스 봇 — data pace)
| 지표 | min | max | 왜 |
|---|---|---|---|
| 한 경기 초(봇, AI level 3) | 90 | 240 | 2~4분 한 바퀴 |
| 봇(무작위 유효 튕김) 승률 % vs AI 3 | 0 | 25 | 아무렇게나 튕겨서는 못 이김 |
| 봇(AI 와 같은 탐색) 승률 % vs AI 3 | 35 | 65 | 같은 세기끼리 — 선공 이점만큼만 |
| 봇(탐색) 승률 % vs AI 1 | 70 | 95 | 난이도 단계가 실제로 차이 남 |
| 경기당 콤보 골 수(탐색 봇) | 0.3 | 2 | 콤보가 가끔 나와야 손맛 |
| 경기당 총 골(탐색 봇 vs AI 2) | 2 | 5 | 골키퍼가 다 막지도, 다 흘리지도 않음 |
| 경기당 「막았다」 수 | 1 | 4 | 골키퍼 다이빙이 보여야 함 |

## 폰 확인 (proto-deploy.sh 가 링크와 함께 출력)
- 끌어 당길 때 손가락 아래 선수가 가려져도 궤적 점선으로 조준이 되나
- 상대 턴 물리 시간이 지루하지 않나(정착 대기 길이)
- 한 손으로 아래 골키퍼까지 끌 수 있나

검증 질문: **"한 번 튕기는 손맛과 AI 상대 수 읽기가 다음 경기를 또 하게 만드나?"** · 성공 기준 숫자: 혼자 5경기 연속 자발 · 안 만드는 것: §7 · 시점: 3/4 탑다운 세로
처음 30초에 배우는 것(순서대로, 하나씩 열기): 끌어서 튕김 → 공을 맞혀야 움직임 → 벽 튕김 → 같은 편에 대 주면 콤보
# brosball — 아트 디렉션 한 장

**화풍 기준 그림**: `art/mock/key.png`(턴제 2:2 목업). 모든 생성은 이 그림을 첫 `-i` 로.
**스프라이트는 투명**: `make_sheet.py`(`cut_sheet.py --keep --holes`), 마젠타 위에서 확인.

## 1. 무드 세 단어
해 질 녘 · 동네 · 들뜬

## 2. 레퍼런스
- `art/mock/key.png` — 코트·카메라·UI 톤 전부
- `../_concepts/dadmap/board-2-cast.png` — 형제 고정 특징
- `art/mock/mock-g2.jpg` — 네 상태(조준·상대 수·콤보·골) 연출 톤
- 가져오지 않는 것: 사진풍 조명, 픽셀

## 3. 키 비주얼
`art/mock/key.png`. 글과 다르면 그림이 이긴다.

## 4. 팔레트
| 자리 | HEX | 메모 |
|---|---|---|
| 코트 | #5f9c8a | 바랜 청록 |
| 코트 선 | #e9e4cf | |
| 우리 팀 | #f2c233 / #4caf50 | 노랑·초록(형·동생·다솜 조끼) |
| 상대 팀 | #d8413a | 빨강 |
| 조준 선·내 턴 링 | #ffe066 | |
| 상대 범위 | #ff5a4a 점선 | |
| UI 바탕 / 글자 | #1d2b45 / #fff3d6 | |

## 5. 형태
- 선: 굵은 진한 선. 면: 2단 음영. 둥근 실루엣, 머리:몸 1:1.2, 팔 있음. 눈: 흰자 있음, 입 있음.

## 6. 시점·빛
- 3/4 탑다운(키 비주얼과 같은 각). 빛 왼쪽 위 노을. 그림자: 코드가 발밑 타원.

## 7. 캐릭터 고정 특징
- 형: 노란 점퍼 · 등번호 1 · 검은 더벅머리 · 노란 운동화
- 동생: 초록 후드 큰 품 · 바가지머리 · 초록 운동화
- 다솜: 파란 캡 · 둥근 안경 · 파란 골키퍼 장갑 · 노란 조끼
- 쌍둥이 A: 긴 포니테일 빨간 머리끈 · 빨간 저지
- 쌍둥이 B: 양갈래 · 빨간 머리띠
- 공구: 덩치 · 짧은 머리 · 주황 장갑

## 8. 금지
사진풍 · 픽셀 · 글자 · 실존 구단 로고 · 검은 배경

## 9. 코드 그림의 한계선
코트 선·골대 테두리 강조·조준 점선·링·궤적·입자·글자 연출·그림자는 코드. 선수·공·코트 그림은 자산.

## 10. 동작-애니메이션 표 (§3b)
| 동작 | 그림 |
|---|---|
| 끌기 | 선수 자세 0 그대로 + 발밑 노란 링 + 끈 선 + 점선 궤적 |
| 뗌 | 선수 자세 1(차기) 6틱 → 0, 공 궤적 잔상 |
| 공 벽 튕김 | 작은 먼지 입자 |
| 득점 | 자세 2(환호/실망) 전원 40틱, 입자·흔들림·빛·「골!」 |
| 콤보 득점 | 위 + 「형제 콤보!」 큰 글자 + 노란 섬광 |
| 상대 턴 | 화면 살짝 파랗게 + 「상대 턴」 띠, AI 가 고른 선수 위 물음표 10틱 뒤 발사 |
# 자산 명세 — brosball

피벗은 셀 안 px, 표시 크기는 논리 px. 레이어 순서: bg, board, items, actors, fx, hud, modal.
선수 시트는 3×3: 행 = 캐릭터, 열 = 자세(0 대기, 1 차기, 2 환호/실망). `frame = row*3+col` 로 고른다. 애니메이션 없음(정지 자세 전환 + 코드 이동). 골키퍼 다이빙(IDEA §2a `save` 이벤트)은 `keeper-dive.png`(2×1: 0 다솜 오른쪽으로, 1 공구 오른쪽으로 — 왼쪽은 코드가 좌우 뒤집음)로 따로 둔다.

| file | kind | cellW | cellH | cols | frames | fps | loop | direction | pivotX | pivotY | displayW | displayH | slice | layer | required |
|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|
| court.png | image | 1024 | 1536 | 1 | 1 | 0 | false | none | 0 | 0 | 1080 | 1620 | null | bg | true |
| home.png | sheet | 256 | 256 | 3 | 9 | 0 | false | up | 128 | 233 | 150 | 150 | null | actors | true |
| away.png | sheet | 256 | 256 | 3 | 9 | 0 | false | down | 128 | 233 | 150 | 150 | null | actors | true |
| ball.png | sheet | 256 | 256 | 1 | 1 | 0 | false | none | 128 | 233 | 60 | 60 | null | items | true |
| keeper-dive.png | sheet | 256 | 256 | 2 | 2 | 0 | false | none | 128 | 233 | 190 | 150 | null | actors | true |

home 행: 0 형 · 1 동생 · 2 다솜(골키퍼). away 행: 0 쌍둥이 A · 1 쌍둥이 B · 2 공구(골키퍼).
court.png 는 코트 그림 한 장(1024×1536, 세로 코트). 그림 안 코트 흰 선 사각형 실측 ≈ x 160~860, y 185~1290(살짝 사다리꼴, 평균값). 코드는 논리 코트(IDEA §1, 1080×1500)를 이 사각형에 맞춰 그림을 늘려 그린다(상수 COURT_RECT_IMG). 위 골대 그림 y≈70~165, 아래 골대 y≈1270~1420 — 논리 골선(0, 1500)은 흰 선에 두고 골대 그림은 그 바깥.

| name | event | length |
|---|---|---|
| kick | flick | 0.1 |
| bounce | bounce | 0.05 |
| goal | goal | 0.4 |
| combo | combo | 0.6 |

