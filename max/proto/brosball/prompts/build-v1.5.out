    set:(obj,key,value)=>(obj[key]=value,true)});
  const canvas={setAttribute(){},width:0,height:0,getBoundingClientRect:()=>({width,height,left:0,top:0}),getContext:()=>drawing,
    addEventListener:(key,fn)=>{listeners[key]=fn;},setPointerCapture(){},toBlob:fn=>fn({type:'image/png'})};
  const elements={data:{textContent:dataText},game:canvas,insets:{},stats:{style:{},innerHTML:''}};
