const fs=require('fs'),vm=require('vm'),assert=require('assert/strict');
function engine(file){const h=fs.readFileSync(file,'utf8'),d=JSON.parse(h.match(/id=\"data\">([\\s\\S]*?)<\\/script>/)[1]),r=h.match(/\\/\\/ === RULES BEGIN ===([\\s\\S]*?)\\/\\/ === RULES END ===/)[1];return {data:d,...vm.runInNewContext(r+';({RULES})')};}
const older=engine('/private/tmp/brosball-before.html'),newer=engine('proto/brosball/index.html');
function state(s){const c=JSON.parse(JSON.stringify(s));delete c.config;for(const p of c.players)delete p.label;return c;}
function events(es){return JSON.parse(JSON.stringify(es.filter(e=>e.k"'!=='"'motion').map(e=>{const c={...e};delete c.until;delete c.flip;return c;})));}
for(const seed of [2463534242,2463638971,2463743700]){
 const log=JSON.parse(fs.readFileSync('proto/brosball/tools/golden/search-'+seed+'.json')),a=older.RULES.init(older.data,seed),b=newer.RULES.init(newer.data,seed);let at=0,count=0;
 while(a.tick<=log.endTick){while(at<log.cmds.length&&log.cmds[at].t===a.tick){const cmd=log.cmds[at++],x=older.RULES.apply(a,cmd),y=newer.RULES.apply(b,cmd);a.rng=cmd.nextRng;assert.deepEqual(events(x.events),events(y.events));count+=x.events.length;assert.deepEqual(state(a),state(b));}if(a.tick===log.endTick)break;
 const x=older.RULES.tick(a),y=newer.RULES.tick(b);assert.deepEqual(events(x.events),events(y.events),'events seed='+seed+' tick='+a.tick);count+=x.events.length;assert.deepEqual(state(a),state(b),'state seed='+seed+' tick='+a.tick);}
 console.log('UNCHANGED seed='+seed+' ticks='+a.tick+' turns='+a.turns+' score='+a.score+' originalEvents='+count);
}
EOF
