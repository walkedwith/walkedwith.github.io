test('봇 · check · sim 기록/상태 오염 없음 · 보관 거부 안전',()=>{
 for(const mode of ['', '?check','?stats']){const r=runtime(430,932,mode,0,0,{}, {storageThrows:true});const before=JSON.stringify(r.T.state()),writes=r.writes();
 const b=r.T.bot(60,'random');assert.equal(b.seconds,60);const c=r.T.check();assert.equal(c.seconds,60);assert(c.changed);assert(!c.idleWin);
 assert.equal(JSON.stringify(r.T.state()),before);assert.equal(r.writes(),writes);assert.equal(r.audio.tones,0);
 }
});
test('그림: SPEC 로드 또는 같은 크기 실루엣 · 누락 정직하게 보고',()=>{
 const r=runtime();const a=r.T.assets();assert.equal(Object.keys(a.files).length,5);assert.equal(a.pending,0);
 const missing=Object.values(a.files).some(v=>v.failed);assert.equal(r.T.check().ok,!missing);if(missing)assert(a.silhouettes>0);
});
test('기록 띠 · 의무 5분 · 유효 입력 · stats',()=>{
 const r=runtime(430,932,'');play(r);r.T.step(301);r.T.input('flick',{who:0,dx:60,dy:0});
 const a=r.T.state();assert.equal(a.loop.inputs,1);assert(Object.values(a.records.dates)[0].active>=300);assert.equal(Object.values(a.records.dates)[0].voluntary,0);
 assert(Object.keys(r.storage).every(k=>k.startsWith('proto_brosball_')));
 const q=runtime(430,932,'?stats');assert.equal(q.writes(),0);for(const text of ['자발 판수','첫 입력 초','중단','코인','콤보'])assert(q.elements.stats.innerHTML.includes(text));
});
test('고정 틱 · 백그라운드 정지',()=>{
 const a=runtime(),b=runtime();a.T.step(1);for(let i=0;i<10;i++)b.T.step(.1);assert.equal(a.T.state().tick,b.T.state().tick);
 const r=runtime();r.frame(0);r.frame(100);const t=r.T.state().tick;r.sandbox.document.hidden=true;r.documentListeners.visibilitychange();r.frame(60000);assert.equal(r.T.state().tick,t);
});

test('입력: 원래 선수에서 끌기 · 첫 충돌 미리보기 · 취소 · 보조 포인터',()=>{
 const r=runtime(),s=r.T.state(),c=s.geometry.court,p=s.players[0],x=c.x+p.x*c.scale,y=c.y+p.y*c.scale;
 const evt=(id,px,py)=>({pointerId:id,clientX:px*430/1080,clientY:py*932/s.geometry.H,preventDefault(){}});
 r.draws.trace=true;r.listeners.pointerdown(evt(1,x,y));r.listeners.pointerdown(evt(2,x,y));
 r.listeners.pointermove(evt(1,x,y+180*c.scale));assert(r.draws.ops.some(v=>v[0]==='setLineDash'));
 r.listeners.pointerup(evt(2,x,y));assert.equal(r.T.state().turns,0);r.listeners.pointerup(evt(1,x,y+180*c.scale));assert.equal(r.T.state().turns,1);assert(r.T.state().players[0].vy<0);
 const q=runtime();q.listeners.pointerdown(evt(1,x,y));q.listeners.pointercancel();q.listeners.pointerup(evt(1,x,y+180*c.scale));assert.equal(q.T.state().turns,0);
});
test('리그: 승리 스티커 · 패배 같은 상대 · 끝 뒤 다음 경기 자동',()=>{
 const {RULES}=isolatedRules();for(const winner of [0,1]){const s=RULES.init(data,8);s.phase='settle';s.turns=20;s.score=winner===0?[1,0]:[0,1];
 const es=RULES.tick(s).events;assert(es.some(e=>e.k==='matchEnd'&&e.winner===winner));assert.equal(s.opponent,winner===0?1:0);assert.equal(s.stickers[0],winner===0);
 for(let i=0;i<data.physics.matchEndTicks;i++)RULES.tick(s);assert.equal(s.phase,'aim');assert.equal(s.round,2);assert.equal(s.score[0],0);assert.equal(s.turns,0);}
});
test('미리보기: 원본 보존 · 60틱 상한 · 첫 접촉에서 종료',()=>{
 const {RULES,simulate}=vm.runInNewContext(rulesSource+';({RULES,simulate})'),s=RULES.init(data,5);s.players[0].x=540;s.players[0].y=850;
 const before=JSON.stringify(s),out=simulate(s,{k:'flick',who:0,dx:0,dy:-360},60);assert.equal(JSON.stringify(s),before);assert(out.ticks<60);assert(out.events.some(e=>e.k==='contact'));assert.equal(out.trace.length,out.ticks);
 assert.throws(()=>runtime().T.sim(0));assert.throws(()=>runtime().T.bot(1,'invalid'));
});
test('골키퍼 연출 · 보상 띠 · 경기별 코인/콤보 기록',()=>{
 const instrumented=source.replace('window.T={state,step,input,load,assets,check,bot,sim};',`window.T={state,step,input,load,assets,check,bot,sim,fixture(){
 rules.phase='settle';rules.ball.x=540;rules.ball.y=1150;rules.ball.vy=8;
 },finishFixture(){rules.phase='settle';rules.players.forEach(p=>{p.vx=0;p.vy=0;});rules.ball.vx=0;rules.ball.vy=0;rules.turns=20;rules.score=[1,0];rules.combos=2;},diveFixture(who){rules.ball.vx=-1;present({events:[{k:'save',who}]});render();},statsFixture:showStats};`);
 const r=runtime(430,932,'',0,0,{}, {source:instrumented});play(r);r.draws.trace=true;r.T.fixture();let saved=false;
 for(let i=0;i<80;i++){r.T.step(1/60);if(r.draws.images.some(v=>v.src==='art/sprites/keeper-dive.png')){saved=true;break;}}
 assert(saved,'dive sprite not rendered');assert(r.draws.ops.some(v=>v[0]==='fillText'&&v[1]==='막았다!'));assert(r.audio.tones>0);
 r.draws.images=[];r.T.step(12/60);assert(!r.draws.images.some(v=>v.src==='art/sprites/keeper-dive.png'),'dive exceeded 12 ticks');
 for(const who of [2,5]){r.draws.images=[];r.T.diveFixture(who);assert(r.draws.images.some(v=>v.src==='art/sprites/keeper-dive.png'&&v.args[0]===(who===2?0:256)));}assert(r.draws.ops.some(v=>v[0]==='scale'&&v[1]===-1));
 r.T.finishFixture();r.T.step(1/60);const row=r.T.state().records.loops.at(-1);assert.equal(row.coins,60);assert.equal(row.combos,2);
 assert(r.draws.ops.some(v=>v[0]==='fillText'&&v[1]==='코인 +60'));assert(r.draws.ops.some(v=>v[0]==='fillText'&&v[1]==='형제 콤보 ×2 +30'));
 r.T.statsFixture();assert(r.elements.stats.innerHTML.includes('<td>60</td>'));
});
test('페이스: 30경기 search/random vs AI 3 · search vs AI 1 · 총 골 vs AI 2',()=>{
 const {search3:b,random3:a,search1:c,search2:d}=paceRuns();
 assert.equal(b.flickShare.length,3);assert(Math.abs(b.flickShare.reduce((a,v)=>a+v,0)-1)<1e-9);
 const metrics={randomWinRate:a.winRate,searchWinRate:b.winRate,easySearchWinRate:c.winRate,avgSeconds:b.avgSeconds,combosPerGame:b.combosPerGame,goalsPerGame:d.goalsPerGame,savesPerGame:b.savesPerGame};
 const failures=Object.entries(data.pace).filter(([key,v])=>!Number.isFinite(metrics[key])||metrics[key]<v.min||metrics[key]>v.max).map(([key,v])=>`${key}: ${metrics[key]} (목표 ${v.min}~${v.max})`);
 for(const [key,result] of Object.entries({search3:b,random3:a,search1:c,search2:d})){if(result.unfinished)failures.push(key+' 미완료 경기 있음');}
 if(a.avgSeconds<data.pace.avgSeconds.min||a.avgSeconds>data.pace.avgSeconds.max)failures.push('random3 초: '+a.avgSeconds);
 assert.equal(failures.length,0,failures.join(' / '));
});
console.log(`${passed} checks passed; ${failed} failed. 실제 터치·소리는 기기 확인 필요.`);if(failed)process.exitCode=1;

