  const ops=r.draws.ops,idx=ops.findIndex(v=>v[0]==='drawImage'&&v[1]?.assetPath==='art/sprites/court.png'),draw=ops[idx],shift=ops.slice(0,idx).reverse().find(v=>v[0]==='translate');
  const x=shift[1]+draw[6],y=shift[2]+draw[7],iw=draw[8],ih=draw[9],g=r.T.state().geometry;
  for(const [lx,ly,ix,iy] of [[0,0,160,185],[1080,1500,860,1290]]){const v=r.T.point(lx,ly);assert(Math.abs(v.x-x-ix/1024*iw)/g.court.scale<=4);assert(Math.abs(v.y-y-iy/1536*ih)/g.court.scale<=4);}
  assert(x>=g.play.x-g.play.w/2-1e-8&&x+iw<=g.play.x+g.play.w/2+1e-8);assert(y>=g.play.y-g.play.h/2-1e-8&&y+ih<=g.play.y+g.play.h/2+1e-8);
  assert(!ops.some(v=>v[0]==='strokeRect'));
 }
});
