   212	 if(kind==='wanted'){if(recording()&&typeof x==='boolean'){daily().wanted=x;save();render();}return;}
   213	 if(kind==='validation'){if(recording()){archive.validation={build:BUILD,date:dateKey(),mode:'play'};for(const row of Object.values(archive.dates)){row.active=0;row.voluntary=0;}if(loopRow)loopRow.eligible=false;save();render();}return;}
   214	 if(kind==='cancel'){pointer=null;return;}
