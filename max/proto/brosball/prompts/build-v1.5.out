   199	 if(item.k==='save'){dives[item.who]={until:rules.tick+12,flip:rules.ball.vx<0};sound(false,true);}
   200	 if(item.k==='payout'){payout=item;if(loopRow){loopRow.coins=item.coins;loopRow.combos=item.combos;}}
