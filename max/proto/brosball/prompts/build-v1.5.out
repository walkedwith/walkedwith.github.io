 let value=Math.hypot(before.ball.x-p.width/2,before.ball.y-target)-Math.hypot(ball.x-p.width/2,ball.y-target),mate=false,combo=false,nearMate=false,nearEnemy=false;
 for(const item of out.events){if(item.k==='goal')value+=item.team===team?a.goalScore:a.ownGoalScore;
  if(item.k==='contact'&&item.b===6&&item.a"'!==out.s.shooter&&before.players[item.a]&&before.players[item.a].team===team)mate=true;
