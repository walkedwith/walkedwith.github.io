 for(const team of [0,1])for(const fast of [false,true]){
  const s=RULES.init(data,17),p=s.players[team*3+2],dir=team===0?1:-1;
  s.phase='settle';s.ball.x=fast?685:540;s.ball.y=team===0?1150:350;s.ball.vy=dir*(fast?30:8);
  const es=[];for(let i=0;i<100&&s.phase==='settle';i++)es.push(...RULES.tick(s).events);
  assert.equal(es.some(e=>e.k==='save'&&e.who===p.id),!fast,JSON.stringify(es));
  assert.equal(es.some(e=>e.k==='goal'),fast);
 }
 const moving=RULES.init(data,21);moving.phase='settle';moving.players[5].x=500;moving.ball.x=600;moving.ball.y=350;moving.ball.vy=-8;const saving=[];for(let i=0;i<80&&moving.phase==='settle';i++)saving.push(...RULES.tick(moving).events);assert(saving.some(e=>e.k==='save'&&e.who===5));assert(moving.players[5].x>500);
 const s=RULES.init(data,18),p=s.players[5],k=data.keeper;s.phase='settle';s.ball.x=1000;s.ball.y=400;s.ball.vy=-8;
 for(let i=0;i<30&&s.phase==='settle';i++){RULES.tick(s);assert(p.x>=540-k.width/2&&p.x<=540+k.width/2);assert(p.y>=0&&p.y<=k.depth);}
 const {simulate}=vm.runInNewContext(rulesSource+';({simulate})');const preview=RULES.init(data,18);preview.ball.y=1150;preview.ball.vy=8;assert(simulate(preview,{k:'flick',who:0,dx:60,dy:0}).events.some(e=>e.k==='save'));
 const u=RULES.init(data,18);u.phase='settle';u.players[5].y=400;u.ball.y=500;u.ball.vy=-8;u.ball.x=800;RULES.tick(u);assert.equal(u.players[5].x,540);
});
