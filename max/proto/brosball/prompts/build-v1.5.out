}
function overlap(a,b){return Math.abs(a.x-b.x)<(a.w+b.w)/2&&Math.abs(a.y-b.y)<(a.h+b.h)/2;}
function assertHUD(r){const g=r.T.state().geometry,boxes=g.hud;for(let i=0;i<boxes.length;i++){
  const a=boxes[i];assert([a.x,a.y,a.w,a.h].every(Number.isFinite),'HUD geometry');assert(a.w>0&&a.h>0);
  assert(a.x-a.w/2>=g.safeL&&a.x+a.w/2<=1080-g.safeR,'HUD horizontal bounds');
  assert(a.y-a.h/2>=g.safeT&&a.y+a.h/2<=g.H-g.safeB,'HUD safe bounds');
  for(const b of boxes.slice(i+1))assert(!overlap(a,b),'overlapping HUD');
}}
// Independent real-runtime measurements run concurrently; all inherit --jitless.
const {Worker,workerData,MessageChannel,receiveMessageOnPort}=require('node:worker_threads');
if(workerData?.pace){
 try{const r=runtime(),before=JSON.stringify(r.T.state()),result=r.T.sim(30,workerData.mode,workerData.level);
  assert.equal(JSON.stringify(r.T.state()),before);assert.equal(r.writes(),0);workerData.port.postMessage({result});
 }catch(err){workerData.port.postMessage({error:err.stack});}
 workerData.port.close();return;
}
function paceRuns(){
 const jobs=[['search',3],['random',3],['search',1],['search',2]].map(([mode,level])=>{
  const {port1,port2}=new MessageChannel(),worker=new Worker(__filename,{workerData:{pace:true,mode,level,port:port2},transferList:[port2]});
  return {key:mode+level,port:port1,worker};
 });
 const pause=new Int32Array(new SharedArrayBuffer(4)),results={},deadline=Date.now()+30*60*1000;
 try{while(jobs.some(job=>!results[job.key])){
  for(const job of jobs){if(results[job.key])continue;const packet=receiveMessageOnPort(job.port);if(!packet)continue;
   if(packet.message.error)throw Error(packet.message.error);results[job.key]=packet.message.result;console.log('T.sim '+job.key+'='+JSON.stringify(results[job.key]));
  }
  if(Date.now()>deadline)throw Error('페이스 측정 30분 초과');if(jobs.some(job=>!results[job.key]))Atomics.wait(pause,0,0,100);
 }return results;}finally{for(const job of jobs){job.port.close();job.worker.terminate();}}
}
let passed=0,failed=0;
function test(label,fn){try{fn();passed++;console.log('PASS '+label);}catch(err){failed++;console.error('FAIL '+label+'\n'+err.stack);}}
function play(r){r.T.input('wanted',true);r.T.input('validation');}

