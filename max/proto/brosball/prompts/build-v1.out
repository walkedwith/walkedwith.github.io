 for(const b of Object.values(g.buttons)){assert(b.w*w/1080>=44-1e-8);assert(b.h*w/1080>=44-1e-8);assert(b.y-b.h/2>=st*1080/w);}
 assert.equal(r.canvas.width,w*2);assert.equal(r.canvas.height,h*2);
 }
});
