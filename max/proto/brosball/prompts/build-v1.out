 const s=RULES.init(data,1);s.phase='settle';s.ball.x=x;s.ball.y=25;s.ball.vy=-30;
 const es=RULES.tick(s).events;assert.equal(es.some(e=>e.k==='goal'),goal);if("'!goal)assert(s.ball.vy>0);
 }
});
test('"'턴: 상대 자동 flick · 20턴 종료 · 동점 연장',()=>{
 const {RULES}=isolatedRules(),s=RULES.init(data,2);RULES.apply(s,{k:'flick',who:0,dx:60,dy:0});let automatic=false;
 for(let i=0;i<600;i++)automatic=RULES.tick(s).events.some(e=>e.k==='flick'&&e.team===1)||automatic;
 assert(automatic);const t=RULES.init(data,3);t.turns=20;t.score=[1,0];t.phase='settle';RULES.tick(t);assert.equal(t.phase,'end');
 const u=RULES.init(data,3);u.turns=20;u.phase='settle';RULES.tick(u);assert.notEqual(u.phase,'end');assert(u.suddenDeath);
});
