 const {RULES,aiPick,simulate}=vm.runInNewContext(rulesSource+';({RULES,aiPick,simulate})');let s=RULES.init(data,9);s.team=1;s.phase='aim';const before=JSON.stringify(s);
 const a=aiPick(s,2),b=aiPick(s,2);assert.equal(JSON.stringify(a),JSON.stringify(b));assert.equal(JSON.stringify(s),before);assert.equal(a.candidates,48);
