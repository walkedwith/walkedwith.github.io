const dataText=html.match(/<script type="application\/json" id="data">([\s\S]*?)<\/script>/)?.[1];
assert(dataText,'data block missing');const data=JSON.parse(dataText);
const rulesSource=source.match(/\/\/ === RULES BEGIN ===([\s\S]*?)\/\/ === RULES END ===/)?.[1];
assert(rulesSource,'RULES region missing');
function isolatedRules(){const context=vm.createContext({});return vm.runInContext(rulesSource+';({RULES,rngInt})',context,{timeout:1000});}
const rulesForbidden=/\b(?:window|document|ctx|geom|Date|localStorage|Image|performance)\b|\bMath\s*\.\s*(?:random|sin|cos|pow|sqrt|round)\b/;
function jsonState(value){
  if(value===null)return;
  assert(!['undefined','function','symbol','bigint'].includes(typeof value),'non-JSON state value');
  if(typeof value==='number')assert(Number.isFinite(value),'non-finite state');
  if(typeof value==='object'){const tag=Object.prototype.toString.call(value);
    assert(tag==='[object Object]'||tag==='[object Array]','non-JSON state object: '+tag);
    if(Array.isArray(value))for(let i=0;i<value.length;i++)assert(Object.hasOwn(value,i),'sparse state array');
    assert.equal(Object.getOwnPropertySymbols(value).length,0,'symbol state key');
    for(const item of Object.values(value))jsonState(item);
  }
}
const forbidden='top|name|status|parent|self|length|origin|screen|event|history|location';
function checkNames(code){
  // Remove comments and literals so labels, paths and object properties are allowed.
  const clean=code.replace(/\/\*[\s\S]*?\*\/|\/\/[^\n]*|'(?:\\.|[^'\\])*'|"(?:\\.|[^"\\])*"|`(?:\\.|[^`\\])*`/g,' ');
  assert(!new RegExp('(?:\\b(?:let|const|var|function|class)\\s+|,\\s*)(?:'+forbidden+')\\s*(?=[=,;({)\\n]|$)').test(clean),'forbidden declaration');
  assert(!new RegExp('\\b(?:let|const|var)\\s*[{[][^;=]*\\b(?:'+forbidden+')\\b').test(clean),'forbidden destructuring declaration');
}
checkNames(source);
assert(!/https?:\/\//.test(html),'external URL');
function runtime(width=430,height=932,search='?check',safeT=0,safeB=0,initialStorage={},options={}){
  const storage={...initialStorage},listeners={},windowListeners={},documentListeners={},frames=[];
  const draws={length:0,images:[],ops:[]},browserErrors=[];let writes=0;
  const drawing=new Proxy({createLinearGradient:()=>({addColorStop(){}})}, {
    get:(obj,key)=>key in obj?obj[key]:(...args)=>{draws.length++;if(draws.trace){draws.ops.push([key,...args]);if(key==='drawImage')draws.images.push({src:args[0]?.assetPath,args:args.slice(1)});}},
    set:(obj,key,value)=>(obj[key]=value,true)});
  const canvas={setAttribute(){},width:0,height:0,getBoundingClientRect:()=>({width,height,left:0,top:0}),getContext:()=>drawing,
    addEventListener:(key,fn)=>{listeners[key]=fn;},setPointerCapture(){},toBlob:fn=>fn({type:'image/png'})};
  const elements={data:{textContent:dataText},game:canvas,insets:{},stats:{style:{},innerHTML:''}};
  class PNG{set src(value){this.assetPath=value;try{const file=path.resolve(root,value);assert(file.startsWith(root+path.sep),'asset escaped root');const data=options.pngFiles?.[value]??fs.readFileSync(file);
    assert.equal(data.subarray(0,8).toString('hex'),'89504e470d0a1a0a','PNG signature');this.naturalWidth=data.readUInt32BE(16);this.naturalHeight=data.readUInt32BE(20);this.complete=true;this.onload?.();
  }catch(err){this.complete=true;this.onerror?.(err);}}}
  const audio={tones:0};class AudioStub{constructor(){this.currentTime=0;this.destination={};}resume(){}
    createGain(){return{gain:{setValueAtTime(){},exponentialRampToValueAtTime(){}},connect(){}};}
    createOscillator(){return{frequency:{setValueAtTime(){}},connect(){},start(){audio.tones++;},stop(){}};}}
  class FixtureURL extends URL{static createObjectURL(){return'blob:fixture';}static revokeObjectURL(){}}
  const sandbox={console:{log(){},error:(...args)=>browserErrors.push(args.join(' ')),warn(){}},URL:FixtureURL,URLSearchParams,Image:PNG,
    Math,Date,JSON,Number,String,Set,Promise,File:class{},AudioContext:AudioStub,devicePixelRatio:2,
    setTimeout:()=>0,clearTimeout(){},requestAnimationFrame:fn=>frames.push(fn),navigator:{},
    getComputedStyle:()=>({paddingTop:String(safeT),paddingBottom:String(safeB),paddingLeft:'0',paddingRight:'0'}),
    localStorage:{getItem:key=>{if(options.storageThrows)throw Error('blocked');return storage[key]??null;},setItem:(key,value)=>{if(options.storageThrows)throw Error('blocked');writes++;storage[key]=value;}},
    location:{search,href:'file:///proto/index.html'+search},addEventListener:(key,fn)=>{windowListeners[key]=fn;},
    document:{hidden:false,getElementById:key=>elements[key],addEventListener:(key,fn)=>{documentListeners[key]=fn;},createElement:()=>({click(){sandbox.downloads++;}})},downloads:0};
  sandbox.window=sandbox;vm.createContext(sandbox);vm.runInContext(options.source??source,sandbox,{timeout:5000});sandbox.T.step(0);
  return{T:sandbox.T,storage,writes:()=>writes,draws,canvas,audio,listeners,windowListeners,documentListeners,elements,sandbox,browserErrors,
    frame:ms=>{const fn=frames.shift();assert(fn,'rAF callback missing');fn(ms);}};
}
function overlap(a,b){return Math.abs(a.x-b.x)<(a.w+b.w)/2&&Math.abs(a.y-b.y)<(a.h+b.h)/2;}
function assertHUD(r){const g=r.T.state().geometry,boxes=g.hud;for(let i=0;i<boxes.length;i++){
  const a=boxes[i];assert([a.x,a.y,a.w,a.h].every(Number.isFinite),'HUD geometry');assert(a.w>0&&a.h>0);
  assert(a.x-a.w/2>=g.safeL&&a.x+a.w/2<=1080-g.safeR,'HUD horizontal bounds');
  assert(a.y-a.h/2>=g.safeT&&a.y+a.h/2<=g.H-g.safeB,'HUD safe bounds');
  for(const b of boxes.slice(i+1))assert(!overlap(a,b),'overlapping HUD');
}}
let passed=0,failed=0;
function test(label,fn){try{fn();passed++;console.log('PASS '+label);}catch(err){failed++;console.error('FAIL '+label+'\n'+err.stack);}}
function play(r){r.T.input('wanted',true);r.T.input('validation');}
test('RULES isolation, forbidden tokens and init/apply/tick contract',()=>{
  assert(!rulesForbidden.test(rulesSource),'forbidden RULES token');
  const {RULES}=isolatedRules(),s=RULES.init(data,2463534242);
  assert.deepEqual(JSON.parse(JSON.stringify(s)),{tick:0,rng:2463534242,score:0,round:1,jobs:[]});
  assert.equal(JSON.stringify(RULES.apply(s,{t:0,k:'tap'})),JSON.stringify({events:[{k:'scored'}]}));
  assert.equal(s.score,1);assert.equal(s.round,2);
  for(let i=0;i<4;i++)RULES.apply(s,{t:s.tick,k:'tap'});
  assert.equal(JSON.stringify(s.jobs),JSON.stringify([{at:30,k:'bonus'}]));
  for(let i=0;i<29;i++)assert.equal(RULES.tick(s).events.length,0);
  assert.equal(JSON.stringify(RULES.tick(s)),JSON.stringify({events:[{k:'bonus'}]}));
  assert.equal(s.tick,30);assert.equal(s.jobs.length,0);
  assert.equal(JSON.stringify(RULES.apply(s,{t:30,k:'ad_reward',slot:'reward'})),JSON.stringify({events:[{k:'ad_reward',slot:'reward'}]}));
  jsonState(s);
});
test('xorshift32 agrees with Godot reference vector',()=>{
  const {rngInt}=isolatedRules(),s={rng:2463534242};
  assert.deepEqual([rngInt(s,4294967296),rngInt(s,4294967296),rngInt(s,4294967296)],[723471715,2497366906,2064144800]);
});
test('same seed and commands, including pending jobs after JSON round-trip, stay deterministic',()=>{
  function run(roundTrip){const {RULES,rngInt}=isolatedRules();let s=RULES.init(data,2463534242);const events=[];
    for(let t=0;t<100;t++){
      if(t%3===0)events.push(...RULES.apply(s,{t:s.tick,k:'tap'}).events);
      rngInt(s,100);jsonState(s);
      if(roundTrip&&t===20){assert(s.jobs.length>0);s=JSON.parse(JSON.stringify(s));}
      events.push(...RULES.tick(s).events);jsonState(s);
    }return JSON.stringify({s,events});
  }
  assert.equal(run(false),run(false));assert.equal(run(true),run(false));
  for(const value of [undefined,()=>{},new Map(),new Set(),{nested:undefined}])assert.throws(()=>jsonState(value));
});
test('forbidden global names, including var, comma and destructuring',()=>{
  for(const key of forbidden.split('|'))for(const declaration of [`const ${key}=0;`,`var ${key};`,`let other=0, ${key}=1;`,`const {${key}}=obj;`])assert.throws(()=>checkNames(declaration));
  checkNames("const label='name'; const obj={name:1}; // const top=1");
});
test('60 seconds, no asset failures/silhouettes, check restores state and never writes',()=>{
  const r=runtime(),before=JSON.stringify(r.T.state()),writes=r.writes();
  const result=r.T.check();assert(result.ok,JSON.stringify(result));assert.equal(result.seconds,60);
  assert.equal(result.assets.failed,0);assert.equal(result.assets.pending,0);assert.equal(result.assets.silhouettes,0);
  assert.equal(JSON.stringify(r.T.state()),before);assert.equal(r.writes(),writes);assert.equal(r.browserErrors.length,0);
});
test('HUD and controls at small/large phones and browser safe areas',()=>{
  for(const [width,height,st,sb] of [[375,667,0,0],[430,932,0,0],[390,664,47,34]]){
    for(const mode of ['', '?check', '?stats']){
      const r=runtime(width,height,mode,st,sb);
      function layoutCheck(expectedStrip){
        assertHUD(r);const g=r.T.state().geometry,strip=g.recordStrip,boxes=Object.values(g.buttons);
        assert.equal(strip.h>0,expectedStrip);assert(strip.h*width/1080<=110,'strip exceeds 110 logical px');
        assert.equal(strip.y-strip.h/2,g.safeT,'strip starts below safe area');
        const regions=[...g.hud,g.play,...(strip.h?[strip]:[])];
        for(let i=0;i<regions.length;i++)for(const other of regions.slice(i+1))assert(!overlap(regions[i],other),'strip/HUD/play overlap');
        for(let i=0;i<boxes.length;i++){const box=boxes[i];
          assert(box.w*width/1080>=44-1e-9&&box.h*width/1080>=44-1e-9,'44pt targets');
          assert(box.y+box.h/2<=g.H-g.safeB&&box.y-box.h/2>=g.safeT,'control safe bounds');
          assert(box.x-box.w/2>=g.safeL&&box.x+box.w/2<=1080-g.safeR,'control horizontal bounds');
          if(['validation','yes','no'].some(key=>g.buttons[key]===box)){
            assert(box.y-box.h/2>=strip.y-strip.h/2&&box.y+box.h/2<=strip.y+strip.h/2,'record control inside strip');
          }
          for(const other of boxes.slice(i+1))assert(!overlap(box,other),'controls overlap');
          for(const other of [...g.hud,g.play])assert(!overlap(box,other),'control overlaps HUD/play');
          if(['bm','social'].some(key=>g.buttons[key]===box)&&strip.h)assert(!overlap(box,strip),'bottom control overlaps strip');
        }
      }
      layoutCheck(mode==='');
      if(mode===''){
        const initial=r.T.state().geometry;
        r.T.input('tap',initial.buttons.validation.x,initial.buttons.validation.y);
        assert(r.T.state().validation);layoutCheck(true); // 질문만 남음
        r.T.input('tap',initial.buttons.yes.x,initial.buttons.yes.y);layoutCheck(false);
        const other=runtime(width,height,'',st,sb);other.T.input('wanted',false);
        assert(other.T.state().geometry.recordStrip.h>0);other.T.input('validation');
        assert.equal(other.T.state().geometry.recordStrip.h,0);
      }
      assert.equal(r.canvas.width,width*2);assert.equal(r.canvas.height,height*2);assert(r.draws.length>0);
    }
  }
});
test('missing art reports failure and same-size silhouette; loaded PNG uses SPEC cell and pivot',()=>{
  const spec="[{file:'missing.png',cellW:32,cellH:32,displayW:80,displayH:90,pivotX:16,pivotY:32,cols:1,frames:1}]";
  const r=runtime(430,932,'?check',0,0,{}, {source:source.replace('const SPEC=[];',`const SPEC=${spec};`).replace("label(S('proto.tap'),", "sprite('missing',540,500);label(S('proto.tap'),")});
  assert.equal(r.T.assets().failed,1);assert(r.T.assets().silhouettes>0);assert.equal(r.T.check().ok,false);
  const png=Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aWQkAAAAASUVORK5CYII=','base64');
  const loaded=runtime(430,932,'?check',0,0,{}, {pngFiles:{'art/sprites/pixel.png':png},source:source
    .replace('const SPEC=[];',"const SPEC=[{file:'pixel.png',cellW:1,cellH:1,displayW:80,displayH:90,pivotX:.5,pivotY:1,cols:1,frames:1}];")
    .replace("label(S('proto.tap'),", "sprite('pixel',540,500);label(S('proto.tap'),")});
  loaded.draws.trace=true;loaded.T.step(0);assert.equal(loaded.T.assets().failed,0);assert.equal(loaded.T.assets().silhouettes,0);
  assert.deepEqual(Array.from(loaded.draws.images[0].args),[0,0,1,1,-40,-90,80,90]);assert(loaded.T.check().ok);
});
test('check in play mode restores records, effects, active ad and reward command',()=>{
  const r=runtime(430,932,'');play(r);r.T.input('tap');r.T.input('bm');r.T.step(2);const before=JSON.stringify(r.T.state()),writes=r.writes();
  assert(r.T.check().ok);assert.equal(JSON.stringify(r.T.state()),before);assert.equal(r.writes(),writes);
  r.T.step(3);assert.equal(r.T.state().ad,null);assert.equal(r.T.state().records.bm[0].completed,1);
});
test('BM ignored after 2s; ad blocks input for 5s, excludes play time, records acceptance',()=>{
  const r=runtime(430,932,'');play(r);r.T.input('tap');r.T.step(2);assert.equal(r.T.state().offer,null);assert(r.T.state().socialOffer);
  r.T.input('tap');r.T.input('bm');const before=r.T.state();r.T.input('tap');r.T.step(4.99);assert(r.T.state().ad);assert.equal(r.T.state().score,before.score);
  r.T.step(.01);assert.equal(r.T.state().ad,null);assert.equal(r.T.state().playTime,before.playTime);
  const metric=r.T.state().records.bm[0];assert.equal(metric.shown,2);assert.equal(metric.pressed,1);assert.equal(metric.completed,1);
});
test('duty is gated by validation; threshold-crossing round remains mandatory',()=>{
  const r=runtime(430,932,'');r.T.input('wanted',true);r.T.step(10);assert.equal(Object.values(r.T.state().records.dates)[0].active,0);
  r.T.input('validation');assert.equal(Object.values(r.T.state().records.dates)[0].wanted,true);
  r.T.step(301);r.T.input('tap');assert.equal(Object.values(r.T.state().records.dates)[0].voluntary,0);
  r.T.input('tap');assert.equal(Object.values(r.T.state().records.dates)[0].voluntary,1);
  assert.equal(r.T.state().records.loops.at(-1).voluntary,true);assert(Object.keys(r.storage).every(key=>key.startsWith(`proto_${r.T.state().proto}_`)));
});
test('fixed time steps and hidden-tab rAF pause without catch-up',()=>{
  const a=runtime(),b=runtime();a.T.step(1);for(let i=0;i<10;i++)b.T.step(.1);assert.equal(a.T.state().clock,b.T.state().clock);
  const r=runtime(430,932,'');play(r);r.frame(0);r.frame(100);const t=r.T.state().playTime;
  r.sandbox.document.hidden=true;r.documentListeners.visibilitychange();r.frame(60000);assert.equal(r.T.state().playTime,t);
  r.sandbox.document.hidden=false;r.documentListeners.visibilitychange();r.frame(70000);assert.equal(r.T.state().playTime,t);
  r.frame(70100);assert(r.T.state().playTime-t<.11);
});
test('pointer counts one completed tap, cancel and secondary pointers do not score',()=>{
  const r=runtime();const e=id=>({pointerId:id,clientX:150,clientY:300,preventDefault(){}});
  r.listeners.pointerdown(e(1));r.listeners.pointerdown(e(2));r.listeners.pointerup(e(2));assert.equal(r.T.state().score,0);
  r.listeners.pointerup(e(1));assert.equal(r.T.state().score,1);
  r.listeners.pointerdown(e(3));r.listeners.pointercancel();r.listeners.pointerup(e(3));assert.equal(r.T.state().score,1);
});
test('storage denied is safe; stats read-only, escaped, date/loop/BM/social tables',()=>{
  const r=runtime(430,932,'',0,0,{}, {storageThrows:true});play(r);r.T.input('tap');r.T.step(1);assert(r.T.check().ok);
  const stats=runtime(430,932,'?stats');assert.equal(stats.writes(),0);const markup=stats.elements.stats.innerHTML;
  for(const text of ['자발 판수','첫 입력 초','수락률','소셜','제작자 혼자의 판정, 편향 있음'])assert(markup.includes(text));
});
test('social has nine fixed neighbors, share download fallback and invitation hook',()=>{
  const r=runtime(430,932,'?scene=social&from=friend');assert.equal(r.T.state().neighbors.length,9);r.T.input('wanted',true);r.T.input('social');
  assert.equal(r.sandbox.downloads,1);const rows=r.T.state().records.social;assert(rows.some(row=>row.slot==='share'&&row.completed===1));assert.equal(r.T.state().from,'friend');
});
// 게임별 검사 — 새 게임에서는 이 예시만 해당 규칙의 검사로 교체한다.
test('example tap increases score and produces immediate reward drawing',()=>{
  const r=runtime();r.draws.trace=true;r.draws.ops=[];const before=r.T.state().score;r.T.input('tap',540,600);r.T.step(0);
  assert.equal(r.T.state().score,before+1);assert(r.draws.ops.filter(op=>op[0]==='arc').length>=24);
});
test('T exposes RULES state, fixed ticks, delayed events and isolated effect randomness',()=>{
  const a=runtime(430,932,'?check&scene=reward'),b=runtime();
  for(let i=0;i<5;i++){a.T.input('tap',300,600);b.T.input('tap',700,900);}
  assert.equal(JSON.stringify(a.T.state().rules),JSON.stringify(b.T.state().rules));
  assert.equal(a.T.state().rules.jobs[0].at,30);a.T.step(.5);
  assert.equal(a.T.state().rules.tick,30);assert.equal(a.T.state().rules.jobs.length,0);
  assert.equal(a.T.state().rules.rng,2463534242);
});
// 페이스 목표는 각 게임 DATA에 둔다. 빈 목표는 실패가 아닌 SKIP.
function paceFailures(result,targets){return Object.entries(targets).flatMap(([metric,target])=>{
  const value=result.metrics?.[metric];
  return Number.isFinite(value)&&Number.isFinite(target.min)&&Number.isFinite(target.max)&&value>=target.min&&value<=target.max?[]:
    [`${metric}: 값=${value} 목표=${target.min}~${target.max} why=${target.why}`];
});}
if(!Object.keys(data.pace??{}).length)console.log('SKIP 페이스: DATA.pace 비어 있음');
else test('페이스 (300초)',()=>{
  const failures=paceFailures(runtime().T.bot(300),data.pace);
  for(const line of failures)console.error('FAIL 페이스 '+line);
  assert.equal(failures.length,0,failures.join('\n'));
});
test('pace bot restores play/check/stats state, effects, pending pointer/ad and storage',()=>{
  for(const mode of ['', '?check', '?stats']){
    const r=runtime(430,932,mode);
    if(mode===''){play(r);r.T.input('tap');r.T.input('bm');r.T.step(2);}
    r.T.input('down',540,600);
    const before=JSON.stringify(r.T.state()),storage=JSON.stringify(r.storage),writes=r.writes(),tones=r.audio.tones;
    const result=r.T.bot(300);assert.equal(result.seconds,300);
    assert.equal(JSON.stringify(r.T.state()),before);assert.equal(JSON.stringify(r.storage),storage);assert.equal(r.writes(),writes);assert.equal(r.audio.tones,tones);
    assert.equal(result.metrics.scoresPerMinute,120);
    assert.throws(()=>r.T.bot(-1));assert.equal(JSON.stringify(r.T.state()),before);
    if(mode===''){r.T.step(3);assert.equal(r.T.state().ad,null);assert.equal(r.T.state().records.bm[0].completed,1);}
  }
  const r=runtime(430,932,'',0,0,{}, {source:source.replace('return {seconds,metrics:{scoresPerMinute:',"throw Error('bot fixture');return {seconds,metrics:{scoresPerMinute:")});
  const before=JSON.stringify(r.T.state()),writes=r.writes();assert.throws(()=>r.T.bot(1));
  assert.equal(JSON.stringify(r.T.state()),before);assert.equal(r.writes(),writes);
  assert.equal(paceFailures({metrics:{rate:0,other:20}},{rate:{min:1,max:2,why:'rare'},other:{min:3,max:4,why:'often'}}).length,2);
  assert.equal(paceFailures({metrics:{}},{missing:{min:1,max:2,why:'required'}}).length,1);
});
console.log(`${passed} checks passed; ${failed} failed. Real touch/audio/share need device verification.`);
if(failed)process.exitCode=1;
})();
</script></body></html>
# proto/AGENTS.md — 시제품 코드를 짓는 에이전트(코덱스)가 지킬 것

이 폴더는 버리는 시제품이다. 본편(`dig.html`)과 무관하다. 저장소 루트 `AGENTS.md` 의 금지 사항도 그대로 지킨다.
절차 전체는 `docs/PROTO_WORKFLOW.md`. 여기는 **코드를 짓는 사람이 알아야 할 것만** 적는다.

## 0. 먼저 읽을 것 (맡은 시제품 폴더 안)
1. `IDEA.md` — 규칙·조작·실패·범위·안 만드는 것
2. `ART.md` — 화면 구성·레이어·크기·동작-애니메이션 표·코드가 그려도 되는 것
3. `SPEC.md` — 그림 파일 이름·크기·바닥 피벗·화면 크기
4. `art/mock/mock-g2.jpg` + `art/mock/layout.json` — **필수.** G2 승인 목표 화면과 그 배치표(논리 좌표·레이어 순서·위치·크기·피벗·카메라 배율). 완성 화면이 이것과 같아 보여야 한다
5. `levels.md` (있으면) — 판별 배치·수치. 판을 직접 설계하지 않는다. IDEA·levels 에 없는 규칙이 필요하면 짓기 전에 멈추고 묻는다

## 1. 쓰는 곳
- `proto/<이름>/index.html` 한 파일. 필요하면 `proto/<이름>/tools/`. 그 밖은 쓰지 않는다. 예외: 공용 도구 작업으로 명시해 맡긴 경우에만 `proto/_template/`.
- `art/` 는 건드리지 않는다(다른 프로세스가 그림을 넣는다). 커밋하지 않는다.
- 외부 요청 0, 상대 경로만, 일반 JS 한 파일, 빌드 없음. `file://` 와 정적 서버 둘 다에서 열린다.

## 2. 그림 연결 — 자동, 끼우는 단계 없음
- `SPEC.md` 의 파일명으로 `art/sprites/<이름>.png` 를 읽는다. 있으면 명세 크기·피벗으로 그리고, 없으면 **같은 크기의 실루엣**(옅은 회보라 둥근 도형)을 그린다.
- 시트 규격은 **SPEC 이 우선**한다(셀 크기·칸 수·방향·피벗). 예: 맥스 본편 시트는 2048×256, 256 칸 8개, 왼쪽을 봄, 발바닥 y≈232.
- 코드가 그려도 되는 것: 하트·버튼 테두리·게이지·미리보기 점선·이펙트(빛·파동·입자)·그림자·실루엣. **캐릭터·소품·배경을 코드로 비슷하게 그리지 않는다.**

## 2a. 규칙과 화면 분리 (Godot 이식 대비, `docs/GODOT_PORT.md` §2 — 의무 다섯)
- 규칙은 `// === RULES BEGIN ===` ~ `// === RULES END ===` 안의 `RULES={init(data,seed), apply(s,cmd), tick(s)}` 만. 구역 안에서 `window·document·ctx·geom·Date·Math.random·localStorage·Image·performance`·`Math.sin/cos/pow/sqrt/round` 금지. 반환 `{events:[…]}`, 연출은 그리는 쪽이 events 를 받아 낸다.
- 상태는 `JSON.parse(JSON.stringify(s))` 로 그대로 살아나야 한다: 클로저·Map·Set·undefined 금지, 예약 작업은 `s.jobs=[{at:틱,k,…}]` 데이터.
- 난수 둘: 규칙은 `rngInt(s,n)`(s.rng xorshift32)만, 연출은 `fxRandom()`.
- 시간은 고정 틱(60틱 = 1초). 규칙엔 `tick()` 만, 초 환산은 그리는 쪽.
- 명령은 논리 단위(칸 번호·단추 id·게임별 논리 정수 좌표) — 화면 픽셀 금지. 날짜·복귀도 명령.

## 2b. 보이는 정보와 기록 띠 (10-22 드워프)
- 플레이어는 다음 몇 수를 고를 정보(칸 종류·적·목표)를 볼 수 있어야 한다. 어둠·안개는 음영(반투명)으로만 그리고 칸을 통째로 가리지 않는다 — 가리는 게 규칙이면 IDEA 에 그렇게 적혀 있을 때만.
- 템플릿 기록 장치(「검증 시작」·「켜고 싶었나」)는 `geom.recordStrip` 띠에만. 게임 HUD·판·단추 위에 띄우지 않는다.
- 페이스 봇: `T.bot(seconds)` 를 게임에 맞게 구현하고(입력은 논리 명령으로, 기록 오염 없이), IDEA 「페이스 목표」 표를 데이터 블록 `pace` 로 옮긴다. check.cjs 「페이스」 검사가 통과해야 한다.

## 3. 실측으로 배운 규칙 (2026-10-17, 어기면 화면이 깨진다)
- **땅은 뒤 배경과 다른 레이어.** 땅은 캐릭터와 같은 속도(1배), 뒤 배경은 느리게. 땅이 느리게 흐르면 캐릭터가 미끄러져 보인다.
- **발판 높이는 땅 그림의 알파에서 읽는다.** 열마다 첫 불투명 픽셀 → 높이표(로드 때 한 번). 손으로 선을 긋지 않는다.
- **능선의 돌기(나무 수관·지붕·기둥)는 깎는다.** 모폴로지 열림(침식→팽창). 창 폭은 그림마다 실측해 정하고, 돌기 폭보다 넓어야 한다(나무 수관이 그림 폭 절반인 경우 있음). 깎는 방식을 바꾸면 판 배치 계산이 연쇄로 바뀌니, 바꾸면 전 판 풀이를 다시 확인한다.
- **배경 그림 안의 실제 내용 높이를 재서 배치한다.** 생성 그림은 위아래에 투명 여백이 크다(예: 724px 중 내용 189~517). 밑변을 땅 윗선에 붙인다.
- **반복 배경은 한 장씩 좌우를 뒤집어 잇고 2px 겹친다.** 이음새가 보이지 않게.
- **끌어 움직이는 층은 화면 밑까지 닿아야 한다.** 짧으면 떠 보인다. 그림이 짧으면 늘려 붙이지 말고(줄무늬가 반복된다) 보고한다.
- **크기는 현실 비율.** `ART.md` 의 기준(예: 울타리 대비)을 따른다. 작아서 안 읽히면 캐릭터만 키우지 말고 카메라 배율을 쓴다.
- **3/4 탑뷰 타일은 윗면이 납작하다.** 정사각형 칸의 윗면 깊이 = 폭 × 약 0.645(실측). 줄 간격을 폭과 같게 두면 칸 사이가 뜬다.

## 4. 테스트 훅과 기록
- `window.T = { state(), step(dt), input(kind, ...), load(n), assets(), check() }`. 숨은 탭에선 화면 갱신이 멈추므로 점검은 이 훅으로만 돈다.
- `T.check()` 는 무작위 입력 60초: 콘솔 오류 0, 그림 로드 실패 0, 실루엣으로 그린 것 0, 상태 변화 있음, 가만히 있어서는 못 이김 — 결과를 객체로 돌려준다.
- 판이 있으면 **모든 판이 풀리는지** 작은 탐색으로 확인하고, 처음부터 풀려 있지 않은지도 확인한다.
- 기록: 브라우저 저장소 키 `proto_<이름>_`. 의무 = 그날 실제 플레이 누적 5분, 그 뒤 입력이 한 번 이상 있었던 판이 자발 판수(§4a). `?stats` 는 날짜별 표, `?check` 는 점검 모드(기록 제외). 저장소 접근은 전부 try/catch.

## 4a. 코어 루프 기록 (필수)
`IDEA.md` 의 코어 루프 표(본다·한다·받는다·다시)를 코드에 그대로 옮긴다. IDEA 의 이벤트 정의(루프 시작·입력 한 번=닿음→뗌·성공·실패·끝)대로 바퀴마다 기록: 시작→첫 입력 시간, 성공까지 입력 수, 한 바퀴 시간, 실패 수, 중단 여부. 백그라운드·판 전환 연출 시간은 뺀다. 루프 기록은 점검 모드만 빼고 첫 빌드부터 쌓고, 자발 판수(의무 5분 뒤 입력이 있었던 판)와 따로 보여 준다. `?stats` 에 판별 표. 판 사이에 메뉴·글자·로딩을 넣지 않는다 — 끝나면 바로 다음 판.

## 4b. 받는 순간의 연출 (필수)
IDEA 의 "받는다·보기" 칸에 적힌 성공 장면을 화면이 크게 바뀌게 만든다: 입자·짧은 화면 흔들림·빛 번짐·색 변화 중 둘 이상 + 효과음 하나. 판정을 위해 S3 에서 이미 있어야 한다.

## 4c. 가짜 BM 자리 (IDEA 에 동기·BM 칸이 있으면 필수)
IDEA 의 BM 자리마다 단추 하나를 그 순간에만 띄운다. 광고 = 누르면 5초 "광고 보는 중" 화면(건너뛰기 없음) 뒤 적힌 보상 지급. 상품 = 창만 열고 닫힘(결제·가격 확정 없음). 자리별 **제시 수·누름 수·수락률**을 기록해 `?stats` 에 루프 표와 따로 보여 준다. 단추가 루프를 막지 않는다 — 무시하면 2초 뒤 접히고 바로 다음 판. 전면 광고는 넣지 않는다.

## 4d. 소셜 자리 (IDEA 에 소셜 한 줄이 있으면 필수)
서버 없이 흉내 낸다: 가짜 이웃(이름·그림·기록 고정 9명)으로 랭킹·놀러 가기·선물·공동 게이지를 채운다. 공유는 `navigator.share({files})` 실제 동작(안 되면 다운로드), 초대는 `?from=` 흉내. 판 끝·하루 끝 같은 멈춤에서만 단추를 띄우고 BM 과 겹치면 BM 먼저. 제시·누름·완료 수를 `?stats` 에.

## 5. 모바일
`viewport-fit=cover`, `touch-action:none`, 스크롤·확대 없음, devicePixelRatio 반영. 가로형 게임은 논리 2340×1080 레터박스.
방향·한 손 여부·UI 자리는 `ART.md`·`layout.json` 을 따른다(게임마다 다름). 늘: 높이 `100dvh`, `env(safe-area-inset-*)` 안쪽에 HUD·단추, 당겨서 새로고침·두 번 탭 확대·길게 눌러 선택 막기, 홈 화면 추가용 웹 앱 메타(`apple-mobile-web-app-capable`·`theme-color`·manifest 한 줄). 단추 44pt·글자 12pt 이상. 375×667·430×932·주소창 있는 모바일 웹에서 글자·그림 겹침 0.

## 6. 끝낼 때 보고 (12줄 이하)
되는 것 · 뺀 것 · 명세에 없어서 정한 것 · 확인 못 한 것(실제 터치 등). 스크린샷은 마지막 한 장만.
# 형제 골목 축구 (가칭) — 새 IP(형제) · 턴제 3:3 스포츠 대전
레퍼런스: 「Soccer Stars」(끌어서 튕기는 턴제 축구) · 「Into the Breach」(상대 수가 보이는 수 싸움) · 「이나즈마 일레븐」(동네 아이들 팀·필살 콤보)
수익 모델: **무료** — 대전 판돈(코인)·유니폼·공 꾸미기·시즌 패스. 시제품은 BM 없이 손맛만 판정(§6b 빠른 트랙).
화풍 기준 그림: `art/mock/key.png`(턴제 2:2 목업 한 장, 10-23) · 캐릭터 `../_concepts/dadmap/board-2-cast.png`. G2 목업 `art/mock/mock-g2.jpg`(네 상태).
경로: 형제×축구 후보 11개 중 사람 "턴제 2:2 목업 만들어봐" → "3명으로 하고 상대는 AI".

## 목표 (§3c-3a)
| 칸 | 내용 |
|---|---|
| 최종 목표 | 동네 다섯 팀을 다 이겨 「우리동네 축구왕」 현수막 주인이 된다 |
| 왜 계속하나 | 다음 상대 팀(잠긴 실루엣 + 이름) · 이긴 팀 스티커가 도감에 붙음 |
| 목표가 보이는 장치 | 경기 끝 화면의 동네 리그 띠(5칸, 이긴 팀 스티커·다음 팀 실루엣) + 경기 중 점수판 |

## 1. 판과 인원
- 코트: 세로 화면 전체. 논리 좌표 코트 폭 1080 × 길이 1500, 위가 상대 골(0), 아래가 내 골(1500). 골 폭 300.
- 우리 팀(아래, 노랑): **형**(강슛, 힘 1.3) · **동생**(빠름, 사거리 짧고 정확, 힘 0.8) · **다솜**(문방구 집 딸, 골키퍼, 막는 반지름 1.4).
- 상대 팀(위, 빨강): **쌍둥이 A**(공격) · **쌍둥이 B**(공격) · **공구**(골키퍼). **AI 가 둔다.**
- 선수는 반지름 48 원, 공은 반지름 24 원. 선수끼리·공과 선수는 원 충돌(탄성 0.6), 벽은 코트 경계(탄성 0.7), 골 폭 안으로 공 중심이 골선 넘으면 득점.

## 2. 턴
- **한 턴 = 한 쪽이 선수 하나를 튕긴다.** 내 턴 → 물리 정착(모든 속도 < 임계) → 상대 턴 → 정착 → 반복. 번갈아 둠(동시 턴은 안 만듦 — 뺀 것 §7).
- 튕기기: 선수 위에서 닿아 뒤로 끌었다 떼면 반대 방향으로 발사. 끈 길이 60~360 → 속도 6~36(논리 px/틱). 끈 길이 60 미만이면 취소.
- 선수는 공에 닿으면 공을 밀고, 선수끼리는 서로 밀쳐 낸다(태클). 공을 직접 끌 수 없다.
- 경기 = 각 팀 10턴(합 20) 또는 먼저 3골. 20턴 끝에 동점이면 다음 골 승.
- 득점 뒤 리셋: 선수 정위치, 공은 센터, 먹힌 팀이 먼저 둔다.

## 3. 콤보(손맛 핵심)
- 내 턴에 공이 **같은 편 선수에 닿고 그 선수가 공을 다시 민 뒤** 2틱 안에 골선을 넘으면 **「형제 콤보!」** — 연출 크게(§4b), 득점 1 은 같음(점수 차이 없음, 손맛만).
- 공이 벽에 1번 이상 튕기고 들어가면 「튕겨 골!」 작은 연출.

## 4. 상대 AI (규칙 안, 결정적)
- 매 상대 턴: 후보 수 N=48개를 만든다 — 선수 셋 × 방향 16 × 힘 1 (힘은 후보마다 rngInt 로 6~36). 각 후보를 **규칙 시뮬레이션 복제본**(JSON 복제)으로 정착까지 돌려 점수 매김:
  - 내 골(아래) 득점 +1000 · 자책 −2000 · 공이 아래 골에 가까워진 거리 +1/px · 공이 우리 편 선수 반지름 100 안이면 +150 · 상대(플레이어) 선수가 공 반지름 120 안이면 −80 · 공구(골키퍼)가 골 앞 200 안에서 벗어나면 −120.
  - 난이도(data `ai.level`): 1 = 후보 중 상위 50% 안에서 rngInt 로 하나, 2 = 상위 20%, 3 = 최고. 기본 2.
- 시뮬레이션은 RULES 안의 순수 함수 `simulate(s, cmd)` 로 — 연출 없음, 틱 상한 600.

## 5. 코어 루프 (§0a)
| 칸 | 내용 |
|---|---|
| 본다 | 코트 전체 · 여섯 선수 · 공 · 점수판 · 남은 턴 · 내 턴 표시(노란 링) |
| 한다 | 선수 하나를 뒤로 끌었다 뗌(닿음→뗌 한 번) · 끄는 동안 예상 궤적 점선(첫 충돌까지) |
| 받는다 | 공이 굴러 결과가 보임 · 득점 시 입자·흔들림·빛·소리 · 콤보면 큰 글자 |
| 실패 | 자책 · 상대 득점 · 20턴 패배 → 바로 재경기(같은 상대) |
| 다시 | 경기 끝 → 리그 띠에 스티커 → 다음 상대 바로 |
| 보기 | 「형제 콤보!」 득점 · 현수막 획득 |
| 한 바퀴 | 한 경기 2~4분 |
| 이벤트 | 루프 시작=경기 시작 · 입력 한 번=튕김 · 성공=승 · 실패=패 · 끝=리그 완주 |

## 6. 동기·BM (§0b)
| 칸 | 내용 |
|---|---|
| 주 동기 | 숙달(각도·힘·콤보) |
| 보조 동기 | 진척(리그 5팀) · 수집(팀 스티커) |
| 아쉬움 자리 | 1점 차 패배 · 콤보 직전 골대 맞음 |
| BM 자리 | (시제품 제외) 재경기 버프 광고 · 꾸미기 |
| 하루 첫 접속 이유 | (시제품 제외) 일일 상대 |
| 소셜 (§0c) | (시제품 제외) 비동기 대결 — 남의 수를 녹화해 상대로 |

## 7. 빼는 것 (시제품)
동시 턴·비동기 대전·BM·소셜·선수 수집(셋째 자리 고정 다솜)·필살기·유니폼·날씨·리그 5팀 중 상대 그림은 한 팀(쌍둥이)만 — 리그 띠는 이름·색만 바꿔 같은 그림 재사용.

## 페이스 목표 (§6 페이스 봇 — data pace)
| 지표 | min | max | 왜 |
|---|---|---|---|
| 한 경기 초(봇, AI level 2) | 90 | 240 | 2~4분 한 바퀴 |
| 봇(무작위 유효 튕김) 승률 % | 0 | 25 | 아무렇게나 튕겨서는 못 이김 |
| 봇(AI 와 같은 탐색) 승률 % | 40 | 70 | 잘 두면 이김 — AI 가 무적이 아님 |
| 경기당 콤보 골 수(탐색 봇) | 0.3 | 2 | 콤보가 가끔 나와야 손맛 |

## 폰 확인 (proto-deploy.sh 가 링크와 함께 출력)
- 끌어 당길 때 손가락 아래 선수가 가려져도 궤적 점선으로 조준이 되나
- 상대 턴 물리 시간이 지루하지 않나(정착 대기 길이)
- 한 손으로 아래 골키퍼까지 끌 수 있나

검증 질문: **"한 번 튕기는 손맛과 AI 상대 수 읽기가 다음 경기를 또 하게 만드나?"** · 성공 기준 숫자: 혼자 5경기 연속 자발 · 안 만드는 것: §7 · 시점: 3/4 탑다운 세로
처음 30초에 배우는 것(순서대로, 하나씩 열기): 끌어서 튕김 → 공을 맞혀야 움직임 → 벽 튕김 → 같은 편에 대 주면 콤보

