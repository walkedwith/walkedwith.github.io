<script type="application/json" id="data">{"pace":{"scoresPerMinute":{"min":110,"max":130,"why":"예시 봇은 초당 두 번 탭해 분당 약 120점을 얻는다"}},"strings":{"proto.tap":"탭하면 +1","proto.aria":"빈 액자: 탭하면 점수 1","proto.loading":"로딩 {percent}%","proto.score":"점수 {score}","proto.duty.done":"✓ 5분","proto.duty.progress":"{seconds} / 300초","proto.duty":"의무 5분","proto.validation":"검증 시작","proto.ad.button":"▶ 보상 광고","proto.share":"공유","proto.wanted":"오늘 켜고 싶었나?","proto.yes":"예","proto.no":"아니오","proto.ad.playing":"광고 보는 중","proto.check":"CHECK","proto.check.ok":"CHECK ✓","proto.check.fail":"CHECK 실패","proto.stats.title":" 기록 · 빌드 ","proto.stats.bias":"제작자 혼자의 판정, 편향 있음","proto.stats.loop":"루프 (첫 빌드부터)","proto.stats.bm":"BM","proto.stats.social":"소셜","proto.done":"완료","proto.progress":"진행 중","proto.unanswered":"미응답","proto.column.0":"날짜","proto.column.1":"모드","proto.column.2":"실제 초","proto.column.3":"자발 판수","proto.column.4":"켜고 싶었나","proto.column.5":"입력","proto.column.6":"빌드","proto.column.7":"판","proto.column.8":"첫 입력 초","proto.column.9":"입력 수","proto.column.10":"시간 초","proto.column.11":"실패","proto.column.12":"중단","proto.column.13":"자발","proto.column.14":"자리","proto.column.15":"제시","proto.column.16":"누름","proto.column.17":"누름률","proto.column.18":"수락률","proto.neighbor.0":"보리","proto.neighbor.1":"콩이","proto.neighbor.2":"두부","proto.neighbor.3":"나리","proto.neighbor.4":"봄이","proto.neighbor.5":"초롱","proto.neighbor.6":"달래","proto.neighbor.7":"토리","proto.neighbor.8":"호두"}}</script>
<script>
(()=>{'use strict';
const DATA=JSON.parse(document.getElementById('data').textContent);
function S(key,values={}){return (DATA.strings[key]??key).replace(/\{(\w+)\}/g,(_,id)=>String(values[id]??''));}
const PROTO='<이름>';
document.title=PROTO;
const BUILD='1', W=1080, DT=1/60;
// SPEC.md 파일명·셀·피벗·표시 크기를 그대로 옮기는 표. 빈 액자는 자산 0개.
// {file:'example.png',kind:'sheet',cellW:256,cellH:256,cols:8,frames:8,fps:8,loop:true,
//  direction:'left',pivotX:128,pivotY:232,displayW:180,displayH:180,slice:null,layer:'actors',required:true}
// 코드에서 sprite('example',x,y,{facing:'right'}) 호출. 후보·반려 폴더는 읽지 않는다.
const SPEC=[];
// === RULES BEGIN ===
function rngInt(s,n){let x=s.rng;x^=x<<13;x>>>=0;x^=x>>>17;x^=x<<5;x>>>=0;s.rng=x;return x%n;}
const RULES={
  init(data,seed){return {tick:0,rng:(seed>>>0)||2463534242,score:0,round:1,jobs:[]};},
  apply(s,cmd){const events=[];
    if(cmd.k==='tap'&&cmd.t===s.tick){s.score++;s.round++;events.push({k:'scored'});
      if(s.score%5===0)s.jobs.push({at:s.tick+30,k:'bonus'});
    }else if(cmd.k==='ad_reward'&&cmd.slot==='reward'){events.push({k:'ad_reward',slot:cmd.slot});}
    return {events};
  },
  tick(s){s.tick++;const events=[];const pending=[];
    for(const job of s.jobs){if(job.at<=s.tick)events.push({k:job.k});else pending.push(job);}
    s.jobs=pending;return {events};
  }
};
// === RULES END ===
const coreLoop={본다:'점수',한다:'탭 한 번(닿음→뗌)',받는다:'점수 +1, 입자·흔들림·빛·소리',다시:'즉시 다음 판',보기:'받는 순간'};
const canvas=document.getElementById('game'),ctx=canvas.getContext('2d');
canvas.setAttribute('aria-label',S('proto.aria'));
const query=new URLSearchParams(window.location.search),checkMode=query.has('check'),statsMode=query.has('stats');
const storageKey=`proto_${PROTO}_records`,copy=v=>JSON.parse(JSON.stringify(v));
const errors=[],pictures={},assetInfo={};let silhouettes=0;
window.addEventListener('error',e=>errors.push(String(e.message)));
window.addEventListener('unhandledrejection',e=>errors.push(String(e.reason)));
let archive={build:BUILD,dates:{},loops:[],bm:[],social:[],validation:null};
try{const stored=JSON.parse(localStorage.getItem(storageKey)||'null');if(stored&&stored.build===BUILD)archive={...archive,...stored};}catch(_){}
let inspecting=false,game,rules,loopRow,ad=null,offer=null,socialOffer=null,pointer=null;
let fx=[],shake=0,flash=0,audioCtx=null,accumulator=0,lastFrame=null,lastSave=0,checkResult=null;
let geom={H:2340,safeT:0,safeB:0,safeL:0,safeR:0,hud:[],buttons:{},recordStrip:{x:540,y:0,w:1080,h:0},play:{x:540,y:0,w:1080,h:0}};
let rng=0x9756321;
function fxRandom(){rng^=rng<<13;rng^=rng>>>17;rng^=rng<<5;return(rng>>>0)/4294967296;}
function dateKey(){const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;}
function recording(){return !checkMode&&!statsMode&&!inspecting;}
function save(){if(!recording())return;try{localStorage.setItem(storageKey,JSON.stringify(archive));}catch(_){}}
function daily(){const key=dateKey();return archive.dates[key]||(archive.dates[key]={build:BUILD,date:key,mode:'play',active:0,voluntary:0,wanted:null,inputs:0});}
function validationActive(){return archive.validation?.build===BUILD;}
function wantedPrompt(){return recording()&&daily().wanted===null;}
function recordMetric(group,slot,field){if(!recording())return;const stamp=dateKey();let row=archive[group].find(v=>v.build===BUILD&&v.date===stamp&&v.slot===slot);if(!row){row={build:BUILD,date:stamp,mode:'play',slot,shown:0,pressed:0,completed:0};archive[group].push(row);}row[field]++;save();}
function beginLoop(){loopRow={build:BUILD,date:dateKey(),mode:'play',round:rules.round,start:game.playTime,firstInput:null,inputs:0,failures:0,voluntary:false,
  eligible:recording()&&validationActive()&&daily().active>=300};}
function endLoop(aborted=false){if(!loopRow)return;if(recording())archive.loops.push({...loopRow,duration:game.playTime-loopRow.start,aborted});loopRow=null;save();}
function registerInput(){loopRow.inputs++;if(loopRow.firstInput===null)loopRow.firstInput=game.playTime-loopRow.start;
  if(recording()){daily().inputs++;if(loopRow.eligible&&validationActive()&&!loopRow.voluntary){loopRow.voluntary=true;daily().voluntary++;}save();}}
function load(n=1){endLoop(true);rules=RULES.init(DATA,2463534242);rules.round=Math.max(1,Math.floor(Number(n))||1);game={clock:0,playTime:0,wins:0,losses:0};
  ad=null;offer=null;socialOffer=null;pointer=null;fx=[];shake=0;flash=0;accumulator=0;beginLoop();render();return state();}
for(const spec of SPEC){const key=spec.file.replace(/\.png$/,''),pic=new Image();pictures[key]=pic;
  const info=assetInfo[key]={...spec,src:`art/sprites/${key}.png`,loaded:false,failed:false};
  pic.onload=()=>{info.loaded=true;render();};pic.onerror=()=>{info.failed=true;render();};pic.src=info.src;
}
function assets(){const all=Object.values(assetInfo);return copy({files:assetInfo,failed:all.filter(v=>v.failed).length,pending:all.filter(v=>!v.loaded&&!v.failed).length,silhouettes});}
function sprite(key,x,y,options={}){const info=assetInfo[key];if(!info)throw Error('SPEC 자산 없음: '+key);
  const width=options.w??info.displayW,height=options.h??info.displayH;
  const cellW=info.cellW,cellH=info.cellH,px=(info.pivotX??cellW/2)/cellW*width,py=(info.pivotY??cellH/2)/cellH*height;
  ctx.save();ctx.translate(x,y);if(options.facing&&options.facing!==info.direction)ctx.scale(-1,1);
  if(info.loaded){const raw=Math.floor(game.clock*(info.fps||0)),frame=options.frame??(info.loop?raw%(info.frames||1):Math.min(raw,(info.frames||1)-1));
    ctx.drawImage(pictures[key],frame%(info.cols||1)*cellW,Math.floor(frame/(info.cols||1))*cellH,cellW,cellH,-px,-py,width,height);
  }else{silhouettes++;ctx.fillStyle='#c9bfd4';ctx.beginPath();ctx.roundRect(-px,-py,width,height,Math.min(width,height)*.2);ctx.fill();}ctx.restore();
}
function resize(){const box=canvas.getBoundingClientRect(),scale=W/Math.max(1,box.width),insets=getComputedStyle(document.getElementById('insets'));
  const dpr=window.devicePixelRatio||1;canvas.width=Math.round(box.width*dpr);canvas.height=Math.round(box.height*dpr);
  geom.H=box.height*scale;geom.safeT=(parseFloat(insets.paddingTop)||0)*scale;geom.safeB=(parseFloat(insets.paddingBottom)||0)*scale;
  geom.safeL=(parseFloat(insets.paddingLeft)||0)*scale;geom.safeR=(parseFloat(insets.paddingRight)||0)*scale;
  layout();render();
}
function layout(){const middle=(geom.safeL+W-geom.safeR)/2,usable=W-geom.safeL-geom.safeR;
  // CSS 논리px → 캔버스 좌표. 띠 52px, 단추 44pt 이상, 한 줄.
  const unit=W/Math.max(1,canvas.getBoundingClientRect().width);
  const wanted=wantedPrompt(),validation=recording()&&!validationActive();
  const stripH=wanted||validation?52*unit:0;
  geom.recordStrip={x:middle,y:geom.safeT+stripH/2,w:usable,h:stripH};
  const hudTop=geom.safeT+stripH;
  geom.hud=[{id:'score',x:middle-usable*.23,y:hudTop+90,w:usable*.4,h:120},{id:'duty',x:middle+usable*.23,y:hudTop+90,w:usable*.4,h:120}];
  const y=geom.H-geom.safeB-100;
  geom.buttons={bm:{x:middle-usable*.23,y,w:usable*.42,h:150},social:{x:middle+usable*.23,y,w:usable*.42,h:150}};
  const stripY=geom.recordStrip.y;
  if(validation)geom.buttons.validation={x:geom.safeL+42*unit,y:stripY,w:84*unit,h:44*unit};
  if(wanted){geom.buttons.yes={x:geom.safeL+usable-70*unit,y:stripY,w:44*unit,h:44*unit};
    geom.buttons.no={x:geom.safeL+usable-22*unit,y:stripY,w:44*unit,h:44*unit};}
  const playTop=hudTop+180,playBottom=y-80;
  geom.play={x:middle,y:(playTop+playBottom)/2,w:usable,h:Math.max(0,playBottom-playTop)};
}

function sound(){if(inspecting||checkMode)return;try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();audioCtx.resume();
  const osc=audioCtx.createOscillator(),gain=audioCtx.createGain(),t=audioCtx.currentTime;osc.frequency.setValueAtTime(660,t);gain.gain.setValueAtTime(.0001,t);
  gain.gain.exponentialRampToValueAtTime(.12,t+.01);gain.gain.exponentialRampToValueAtTime(.0001,t+.18);osc.connect(gain);gain.connect(audioCtx.destination);osc.start(t);osc.stop(t+.2);
}catch(_){}}
function receive(x,y){shake=9;flash=.2;sound();for(let i=0;i<24;i++){const angle=fxRandom()*Math.PI*2,speed=90+fxRandom()*270;
  fx.push({x,y,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed-80,life:.8,size:5+fxRandom()*9});}}
function showBM(){offer={left:2};socialOffer=null;recordMetric('bm','reward','shown');}
function showSocial(){socialOffer={left:2};recordMetric('social','share','shown');}
function startAd(slot){if(!offer||ad)return;recordMetric('bm','reward','pressed');offer=null;socialOffer=null;ad={left:5,slot};}
function present(result,x=W/2,y=geom.H/2){for(const item of result.events){
  if(item.k==='scored'){game.wins++;receive(x,y);endLoop();beginLoop();showBM();}
  else if(item.k==='bonus'||item.k==='ad_reward')receive(x,y);
}}
const neighbors=Array.from({length:9},(_,i)=>({label:S('proto.neighbor.'+i),picture:null,record:90-i*8,gift:1}));
// picture에는 SPEC의 승인된 이웃 그림 키를 넣는다. 없을 때는 실루엣.
function share(){recordMetric('social','share','pressed');socialOffer=null;render();
  canvas.toBlob(async blob=>{if(!blob)return;const file=new File([blob],`${PROTO}.png`,{type:'image/png'});let completed=false;
    try{if(navigator.share&&(!navigator.canShare||navigator.canShare({files:[file]}))){await navigator.share({files:[file],title:PROTO});completed=true;}}catch(err){if(err.name==='AbortError')return;}
    if(!completed){const url=URL.createObjectURL(blob),link=document.createElement('a');link.href=url;link.download=`${PROTO}.png`;link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}
    recordMetric('social','share','completed');
  },'image/png');
}
function hit(x,y,box){return Math.abs(x-box.x)<=box.w/2&&Math.abs(y-box.y)<=box.h/2;}
function input(kind,x=W/2,y=geom.H/2){if(!game||(statsMode&&!inspecting)||assets().pending)return;
  if(kind==='down'){if(!ad)pointer={x,y};return;}if(kind==='cancel'){pointer=null;return;}
  if(kind==='up'){if(!pointer)return;const first=pointer;pointer=null;if(Math.hypot(x-first.x,y-first.y)>35)return;kind='tap';}
  if(ad)return;
  if(kind==='wanted'){if(recording()&&typeof x==='boolean'){daily().wanted=x;save();render();}return;}
  if(kind==='validation'){if(recording()){endLoop(true);archive.validation={build:BUILD,date:dateKey(),mode:'play'};for(const row of Object.values(archive.dates)){row.active=0;row.voluntary=0;}beginLoop();save();render();}return;}
  if(kind==='bm'){startAd('reward');return;}if(kind==='social'){if(socialOffer)share();return;}
  if(kind!=='tap')return;
  layout();
  if(geom.buttons.yes&&hit(x,y,geom.buttons.yes)){input('wanted',true);return;}
  if(geom.buttons.no&&hit(x,y,geom.buttons.no)){input('wanted',false);return;}
  if(geom.buttons.validation&&hit(x,y,geom.buttons.validation)){input('validation');return;}
  if(wantedPrompt()||hit(x,y,geom.recordStrip))return;
  if(offer&&hit(x,y,geom.buttons.bm)){input('bm');return;}if(socialOffer&&hit(x,y,geom.buttons.social)){input('social');return;}
  if(!hit(x,y,geom.play))return;
  registerInput();
  // 게임: 여기 — 탭하면 점수 +1, 성공 연출. 메뉴 없이 바로 다음 판.
  present(RULES.apply(rules,{t:rules.tick,k:'tap'}),x,y);
}
function simulate(dt){if(!game)return;game.clock+=dt;
  for(const p of fx){p.life-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=300*dt;}fx=fx.filter(p=>p.life>0);shake=Math.max(0,shake-dt*24);flash=Math.max(0,flash-dt);
  if(ad){ad.left-=dt;if(ad.left<=1e-8){const slot=ad.slot;ad=null;recordMetric('bm',slot,'completed');present(RULES.apply(rules,{t:rules.tick,k:'ad_reward',slot}));showSocial();}return;}
  if(wantedPrompt())return;
  if(loopRow.date!==dateKey()){endLoop(true);beginLoop();}
  present(RULES.tick(rules));
  game.playTime+=dt;
  if(recording()&&validationActive())daily().active+=dt;
  if(recording()&&game.clock-lastSave>=1){lastSave=game.clock;save();}
  if(offer){offer.left-=dt;if(offer.left<=1e-8){offer=null;showSocial();}}
  else if(socialOffer){socialOffer.left-=dt;if(socialOffer.left<=1e-8)socialOffer=null;}
}
function advance(seconds){if(!Number.isFinite(seconds)||seconds<0)throw Error('step: 유한한 0 이상 초');accumulator+=seconds;
  while(accumulator+1e-9>=DT){simulate(DT);accumulator-=DT;}}
function step(seconds=0){advance(seconds);render();return state();}
function label(text,x,y,size=40){ctx.fillStyle='#493b55';ctx.font=`${size}px system-ui`;ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(String(text),x,y);}
function panel(box,text,size=40){ctx.fillStyle='#fffafc';ctx.beginPath();ctx.roundRect(box.x-box.w/2,box.y-box.h/2,box.w,box.h,24);ctx.fill();label(text,box.x,box.y,size);}
function render(){if(!game||!canvas.width)return;layout();ctx.setTransform(canvas.width/W,0,0,canvas.height/geom.H,0,0);ctx.fillStyle='#eee8f2';ctx.fillRect(0,0,W,geom.H);
  const all=Object.values(assetInfo),done=all.filter(v=>v.loaded||v.failed).length;
  if(done<all.length){label(S('proto.loading',{percent:Math.round(done/all.length*100)}),W/2,geom.H/2);return;}
  ctx.save();ctx.translate(Math.sin(game.clock*73)*shake,Math.cos(game.clock*67)*shake*.6);
  // 게임: 여기 — SPEC 자산은 sprite(파일명, 피벗x, 피벗y)로 그린다.
  label(S('proto.tap'),W/2,geom.play.y,54);
  for(const p of fx){ctx.globalAlpha=p.life/.8;ctx.fillStyle='#f7ca62';ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,Math.PI*2);ctx.fill();}ctx.restore();
  if(flash){ctx.fillStyle=`rgba(255,241,155,${flash})`;ctx.fillRect(0,0,W,geom.H);}
  panel(geom.hud[0],S('proto.score',{score:rules.score}));panel(geom.hud[1],recording()&&validationActive()?(daily().active>=300?S('proto.duty.done'):S('proto.duty.progress',{seconds:Math.floor(daily().active)})):S('proto.duty'));
  const unit=W/Math.max(1,canvas.getBoundingClientRect().width);
  if(geom.buttons.validation)panel(geom.buttons.validation,S('proto.validation'),12*unit);
  if(geom.buttons.yes){
    const left=geom.buttons.validation?geom.buttons.validation.x+geom.buttons.validation.w/2:geom.safeL;
    const right=geom.buttons.yes.x-geom.buttons.yes.w/2;
    label(S('proto.wanted'),(left+right)/2,geom.recordStrip.y,12*unit);
    panel(geom.buttons.yes,S('proto.yes'),12*unit);panel(geom.buttons.no,S('proto.no'),12*unit);
  }
  if(offer)panel(geom.buttons.bm,S('proto.ad.button'));else if(socialOffer){
    neighbors.forEach((neighbor,i)=>{const y=geom.play.y-geom.play.h/2+100+i*90;
      if(neighbor.picture)sprite(neighbor.picture,230,y,{w:64,h:64});
      else{ctx.fillStyle='#c9bfd4';ctx.beginPath();ctx.roundRect(198,y-32,64,64,16);ctx.fill();}
      label(`${i+1}  ${neighbor.label}    ${neighbor.record}`,560,y,36);
    });panel(geom.buttons.social,S('proto.share'));
  }
  if(ad){ctx.fillStyle='#eee8f2';ctx.fillRect(0,0,W,geom.H);label(S('proto.ad.playing'),W/2,geom.H*.45,54);label(Math.ceil(ad.left),W/2,geom.H*.52,54);}
  if(checkMode)label(checkResult?S(checkResult.ok?'proto.check.ok':'proto.check.fail'):S('proto.check'),W/2,geom.H-geom.safeB-36,36);
}
function state(){return copy({proto:PROTO,build:BUILD,...game,...rules,rules,loop:loopRow,geometry:geom,ad:ad?{left:ad.left}:null,offer,socialOffer,neighbors,coreLoop,from:query.get('from'),
  validation:archive.validation,records:archive,checkResult});}
function inspect(run){const saved={inspecting,game:copy(game),rules:copy(rules),loopRow:copy(loopRow),archive:copy(archive),ad,offer,socialOffer,pointer,fx,shake,flash,rng,accumulator,lastSave,silhouettes};
  inspecting=true;
  try{return run();}
  finally{({inspecting,game,rules,loopRow,archive,ad,offer,socialOffer,pointer,fx,shake,flash,rng,accumulator,lastSave,silhouettes}=saved);render();}
}
// 게임마다 이 봇의 행동과 metrics를 설계 의도에 맞게 교체한다.
function bot(seconds){if(!Number.isFinite(seconds)||seconds<=0)throw Error('bot: 유한한 양수 초');
  return inspect(()=>{load(1);const ticks=Math.ceil(seconds/DT);
    for(let tick=0;tick<ticks;tick++){if(tick%30===0)input('tap',geom.play.x,geom.play.y);advance(Math.min(DT,seconds-tick*DT));}
    return {seconds,metrics:{scoresPerMinute:rules.score/seconds*60}};
  });
}
function check(){return inspect(()=>{let result;
  try{load(1);const initiallyUnfinished=game.wins===0&&game.losses===0;step(60);const idleCannotWin=game.wins===0&&game.losses===0;
    load(1);const initial=rules.score;
    for(let tick=0;tick<600;tick++){if(tick%7===0)input('tap',geom.play.x+(fxRandom()-.5)*geom.play.w,geom.play.y+(fxRandom()-.5)*geom.play.h);step(.1);}
    const info=assets(),stateChanged=rules.score!==initial;
    result={ok:errors.length===0&&info.failed===0&&info.pending===0&&info.silhouettes===0&&initiallyUnfinished&&idleCannotWin&&stateChanged,
      build:BUILD,date:dateKey(),mode:'check',seconds:60,errors:errors.slice(),assets:info,initiallyUnfinished,idleCannotWin,stateChanged};
  }catch(err){result={ok:false,build:BUILD,date:dateKey(),mode:'check',seconds:60,error:String(err)};}
  return result;
});}
function showStats(){const el=document.getElementById('stats');el.style.display='block';
  const escape=value=>String(value??'—').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const table=(headers,rows)=>'<table><tr>'+headers.map(v=>'<th>'+escape(v)+'</th>').join('')+'</tr>'+rows.map(row=>'<tr>'+row.map(v=>'<td>'+escape(v)+'</td>').join('')+'</tr>').join('')+'</table>';
  const percent=(a,b)=>b?Math.round(a/b*100)+'%':'0%';
  el.innerHTML='<h2>'+escape(PROTO)+escape(S('proto.stats.title'))+escape(BUILD)+'</h2><p>'+escape(S('proto.stats.bias'))+'</p>'+
    table([S('proto.column.0'),S('proto.column.1'),S('proto.column.2'),S('proto.duty'),S('proto.column.3'),S('proto.column.4'),S('proto.column.5')],Object.entries(archive.dates).map(([d,r])=>[d,r.mode,Math.floor(r.active),r.active>=300?S('proto.done'):S('proto.progress'),r.voluntary,r.wanted===null?S('proto.unanswered'):r.wanted?S('proto.yes'):S('proto.no'),r.inputs]))+
    '<h3>'+escape(S('proto.stats.loop'))+'</h3>'+table([S('proto.column.6'),S('proto.column.0'),S('proto.column.1'),S('proto.column.7'),S('proto.column.8'),S('proto.column.9'),S('proto.column.10'),S('proto.column.11'),S('proto.column.12'),S('proto.column.13')],archive.loops.map(r=>[r.build,r.date,r.mode,r.round,r.firstInput,r.inputs,r.duration.toFixed(2),r.failures,r.aborted,r.voluntary]))+
    '<h3>'+escape(S('proto.stats.bm'))+'</h3>'+table([S('proto.column.6'),S('proto.column.0'),S('proto.column.1'),S('proto.column.14'),S('proto.column.15'),S('proto.column.16'),S('proto.done'),S('proto.column.17'),S('proto.column.18')],archive.bm.map(r=>[r.build,r.date,r.mode,r.slot,r.shown,r.pressed,r.completed,percent(r.pressed,r.shown),percent(r.completed,r.shown)]))+
    '<h3>'+escape(S('proto.stats.social'))+'</h3>'+table([S('proto.column.6'),S('proto.column.0'),S('proto.column.1'),S('proto.column.14'),S('proto.column.15'),S('proto.column.16'),S('proto.done')],archive.social.map(r=>[r.build,r.date,r.mode,r.slot,r.shown,r.pressed,r.completed]));
}
window.T={state,step,input,load,assets,check,bot};
function pointerXY(e){const box=canvas.getBoundingClientRect();return[(e.clientX-box.left)*W/box.width,(e.clientY-box.top)*geom.H/box.height];}
canvas.addEventListener('pointerdown',e=>{e.preventDefault();if(pointer)return;canvas.setPointerCapture(e.pointerId);pointer={id:e.pointerId};input('down',...pointerXY(e));if(pointer)pointer.id=e.pointerId;});
canvas.addEventListener('pointerup',e=>{e.preventDefault();if(pointer?.id===e.pointerId)input('up',...pointerXY(e));});
for(const kind of ['pointercancel','lostpointercapture'])canvas.addEventListener(kind,()=>input('cancel'));
canvas.addEventListener('contextmenu',e=>e.preventDefault());document.addEventListener('gesturestart',e=>e.preventDefault());
window.addEventListener('resize',resize);
document.addEventListener('visibilitychange',()=>{lastFrame=null;pointer=null;if(document.hidden)save();});
window.addEventListener('pagehide',()=>{endLoop(true);save();});
window.addEventListener('pageshow',()=>{lastFrame=null;if(game&&!loopRow)beginLoop();});
resize();load(1);
// 장면 바로가기 자리: ?scene=reward|bm|social (점검 시 ?check&scene=...)
const scenes={reward:()=>receive(W/2,geom.H/2),bm:showBM,social:showSocial};
if(scenes[query.get('scene')])scenes[query.get('scene')]();
if(query.has('from'))recordMetric('social','invite-arrival','completed');
if(statsMode)showStats();
function frame(ms){if(!document.hidden&&!statsMode){if(lastFrame!==null)advance(Math.min(.1,(ms-lastFrame)/1000));
    if(checkMode&&checkResult===null&&assets().pending===0)checkResult=check();render();lastFrame=ms;
  }else lastFrame=null;requestAnimationFrame(frame);}
requestAnimationFrame(frame);
})();
</script></body></html>
/* Canvas fixture extracted from garden; PNG files and prototype JS are real.
   Run: node --jitless tools/check.cjs. No browser/network/dependencies. */
'use strict';
if(!process.execArgv.includes('--jitless')){
  const run=require('node:child_process').spawnSync(process.execPath,['--jitless',__filename,...process.argv.slice(2)],{stdio:'inherit'});
  if(run.error)throw run.error;process.exit(run.status??1);
}
const fs=require('node:fs'),path=require('node:path'),vm=require('node:vm'),assert=require('node:assert/strict');
const root=path.resolve(__dirname,'..'),html=fs.readFileSync(path.join(root,'index.html'),'utf8');
const source=html.match(/<script>([\s\S]*?)<\/script>/)?.[1];
assert(source,'inline script missing');new vm.Script(source);
const dataText=html.match(/<script type="application\/json" id="data">([\s\S]*?)<\/script>/)?.[1];
assert(dataText,'data block missing');const data=JSON.parse(dataText);
const rulesSource=source.match(/\/\/ === RULES BEGIN ===([\s\S]*?)\/\/ === RULES END ===/)?.[1];
assert(rulesSource,'RULES region missing');
function isolatedRules(){const context=vm.createContext({});return vm.runInContext(rulesSource+';({RULES,rngInt})',context,{timeout:1000});}
const rulesForbidden=/\b(?:window|document|ctx|geom|Date|localStorage|Image|performance)\b|\bMath\s*\.\s*(?:random|sin|cos|pow|sqrt|round)\b/;
function jsonState(value){
  if(value===null)return;
  assert(!['undefined','function','symbol','bigint'].includes(typeof value),'non-JSON state value');
  if(typeof value==='number')assert(Number.isFinite(value),'non-finite state');
  if(typeof value==='object'){const tag=Object.prototype.toString.call(value);
    assert(tag==='[object Object]'||tag==='[object Array]','non-JSON state object: '+tag);
    if(Array.isArray(value))for(let i=0;i<value.length;i++)assert(Object.hasOwn(value,i),'sparse state array');
    assert.equal(Object.getOwnPropertySymbols(value).length,0,'symbol state key');
    for(const item of Object.values(value))jsonState(item);
  }
}
const forbidden='top|name|status|parent|self|length|origin|screen|event|history|location';
function checkNames(code){
  // Remove comments and literals so labels, paths and object properties are allowed.
  const clean=code.replace(/\/\*[\s\S]*?\*\/|\/\/[^\n]*|'(?:\\.|[^'\\])*'|"(?:\\.|[^"\\])*"|`(?:\\.|[^`\\])*`/g,' ');
  assert(!new RegExp('(?:\\b(?:let|const|var|function|class)\\s+|,\\s*)(?:'+forbidden+')\\s*(?=[=,;({)\\n]|$)').test(clean),'forbidden declaration');
  assert(!new RegExp('\\b(?:let|const|var)\\s*[{[][^;=]*\\b(?:'+forbidden+')\\b').test(clean),'forbidden destructuring declaration');
}
checkNames(source);
assert(!/https?:\/\//.test(html),'external URL');
function runtime(width=430,height=932,search='?check',safeT=0,safeB=0,initialStorage={},options={}){
  const storage={...initialStorage},listeners={},windowListeners={},documentListeners={},frames=[];
  const draws={length:0,images:[],ops:[]},browserErrors=[];let writes=0;
  const drawing=new Proxy({createLinearGradient:()=>({addColorStop(){}})}, {
    get:(obj,key)=>key in obj?obj[key]:(...args)=>{draws.length++;if(draws.trace){draws.ops.push([key,...args]);if(key==='drawImage')draws.images.push({src:args[0]?.assetPath,args:args.slice(1)});}},
    set:(obj,key,value)=>(obj[key]=value,true)});
  const canvas={setAttribute(){},width:0,height:0,getBoundingClientRect:()=>({width,height,left:0,top:0}),getContext:()=>drawing,
    addEventListener:(key,fn)=>{listeners[key]=fn;},setPointerCapture(){},toBlob:fn=>fn({type:'image/png'})};
  const elements={data:{textContent:dataText},game:canvas,insets:{},stats:{style:{},innerHTML:''}};
  class PNG{set src(value){this.assetPath=value;try{const file=path.resolve(root,value);assert(file.startsWith(root+path.sep),'asset escaped root');const data=options.pngFiles?.[value]??fs.readFileSync(file);
    assert.equal(data.subarray(0,8).toString('hex'),'89504e470d0a1a0a','PNG signature');this.naturalWidth=data.readUInt32BE(16);this.naturalHeight=data.readUInt32BE(20);this.complete=true;this.onload?.();
  }catch(err){this.complete=true;this.onerror?.(err);}}}
  const audio={tones:0};class AudioStub{constructor(){this.currentTime=0;this.destination={};}resume(){}
    createGain(){return{gain:{setValueAtTime(){},exponentialRampToValueAtTime(){}},connect(){}};}
    createOscillator(){return{frequency:{setValueAtTime(){}},connect(){},start(){audio.tones++;},stop(){}};}}
  class FixtureURL extends URL{static createObjectURL(){return'blob:fixture';}static revokeObjectURL(){}}
  const sandbox={console:{log(){},error:(...args)=>browserErrors.push(args.join(' ')),warn(){}},URL:FixtureURL,URLSearchParams,Image:PNG,
    Math,Date,JSON,Number,String,Set,Promise,File:class{},AudioContext:AudioStub,devicePixelRatio:2,
    setTimeout:()=>0,clearTimeout(){},requestAnimationFrame:fn=>frames.push(fn),navigator:{},
    getComputedStyle:()=>({paddingTop:String(safeT),paddingBottom:String(safeB),paddingLeft:'0',paddingRight:'0'}),
    localStorage:{getItem:key=>{if(options.storageThrows)throw Error('blocked');return storage[key]??null;},setItem:(key,value)=>{if(options.storageThrows)throw Error('blocked');writes++;storage[key]=value;}},
    location:{search,href:'file:///proto/index.html'+search},addEventListener:(key,fn)=>{windowListeners[key]=fn;},
    document:{hidden:false,getElementById:key=>elements[key],addEventListener:(key,fn)=>{documentListeners[key]=fn;},createElement:()=>({click(){sandbox.downloads++;}})},downloads:0};
  sandbox.window=sandbox;vm.createContext(sandbox);vm.runInContext(options.source??source,sandbox,{timeout:5000});sandbox.T.step(0);
  return{T:sandbox.T,storage,writes:()=>writes,draws,canvas,audio,listeners,windowListeners,documentListeners,elements,sandbox,browserErrors,
    frame:ms=>{const fn=frames.shift();assert(fn,'rAF callback missing');fn(ms);}};
}
function overlap(a,b){return Math.abs(a.x-b.x)<(a.w+b.w)/2&&Math.abs(a.y-b.y)<(a.h+b.h)/2;}
function assertHUD(r){const g=r.T.state().geometry,boxes=g.hud;for(let i=0;i<boxes.length;i++){
  const a=boxes[i];assert([a.x,a.y,a.w,a.h].every(Number.isFinite),'HUD geometry');assert(a.w>0&&a.h>0);
  assert(a.x-a.w/2>=g.safeL&&a.x+a.w/2<=1080-g.safeR,'HUD horizontal bounds');
  assert(a.y-a.h/2>=g.safeT&&a.y+a.h/2<=g.H-g.safeB,'HUD safe bounds');
  for(const b of boxes.slice(i+1))assert(!overlap(a,b),'overlapping HUD');
}}
let passed=0,failed=0;
function test(label,fn){try{fn();passed++;console.log('PASS '+label);}catch(err){failed++;console.error('FAIL '+label+'\n'+err.stack);}}
function play(r){r.T.input('wanted',true);r.T.input('validation');}
test('RULES isolation, forbidden tokens and init/apply/tick contract',()=>{
  assert(!rulesForbidden.test(rulesSource),'forbidden RULES token');
  const {RULES}=isolatedRules(),s=RULES.init(data,2463534242);
  assert.deepEqual(JSON.parse(JSON.stringify(s)),{tick:0,rng:2463534242,score:0,round:1,jobs:[]});
  assert.equal(JSON.stringify(RULES.apply(s,{t:0,k:'tap'})),JSON.stringify({events:[{k:'scored'}]}));
  assert.equal(s.score,1);assert.equal(s.round,2);
  for(let i=0;i<4;i++)RULES.apply(s,{t:s.tick,k:'tap'});
  assert.equal(JSON.stringify(s.jobs),JSON.stringify([{at:30,k:'bonus'}]));
  for(let i=0;i<29;i++)assert.equal(RULES.tick(s).events.length,0);
  assert.equal(JSON.stringify(RULES.tick(s)),JSON.stringify({events:[{k:'bonus'}]}));
  assert.equal(s.tick,30);assert.equal(s.jobs.length,0);
  assert.equal(JSON.stringify(RULES.apply(s,{t:30,k:'ad_reward',slot:'reward'})),JSON.stringify({events:[{k:'ad_reward',slot:'reward'}]}));
  jsonState(s);
});
test('xorshift32 agrees with Godot reference vector',()=>{
  const {rngInt}=isolatedRules(),s={rng:2463534242};
  assert.deepEqual([rngInt(s,4294967296),rngInt(s,4294967296),rngInt(s,4294967296)],[723471715,2497366906,2064144800]);
});
test('same seed and commands, including pending jobs after JSON round-trip, stay deterministic',()=>{
  function run(roundTrip){const {RULES,rngInt}=isolatedRules();let s=RULES.init(data,2463534242);const events=[];
    for(let t=0;t<100;t++){
      if(t%3===0)events.push(...RULES.apply(s,{t:s.tick,k:'tap'}).events);
      rngInt(s,100);jsonState(s);
      if(roundTrip&&t===20){assert(s.jobs.length>0);s=JSON.parse(JSON.stringify(s));}
      events.push(...RULES.tick(s).events);jsonState(s);
    }return JSON.stringify({s,events});
  }
  assert.equal(run(false),run(false));assert.equal(run(true),run(false));
  for(const value of [undefined,()=>{},new Map(),new Set(),{nested:undefined}])assert.throws(()=>jsonState(value));
});
test('forbidden global names, including var, comma and destructuring',()=>{
  for(const key of forbidden.split('|'))for(const declaration of [`const ${key}=0;`,`var ${key};`,`let other=0, ${key}=1;`,`const {${key}}=obj;`])assert.throws(()=>checkNames(declaration));
  checkNames("const label='name'; const obj={name:1}; // const top=1");
});
test('60 seconds, no asset failures/silhouettes, check restores state and never writes',()=>{
  const r=runtime(),before=JSON.stringify(r.T.state()),writes=r.writes();
  const result=r.T.check();assert(result.ok,JSON.stringify(result));assert.equal(result.seconds,60);
  assert.equal(result.assets.failed,0);assert.equal(result.assets.pending,0);assert.equal(result.assets.silhouettes,0);
  assert.equal(JSON.stringify(r.T.state()),before);assert.equal(r.writes(),writes);assert.equal(r.browserErrors.length,0);
});
test('HUD and controls at small/large phones and browser safe areas',()=>{
  for(const [width,height,st,sb] of [[375,667,0,0],[430,932,0,0],[390,664,47,34]]){
    for(const mode of ['', '?check', '?stats']){
      const r=runtime(width,height,mode,st,sb);
      function layoutCheck(expectedStrip){
        assertHUD(r);const g=r.T.state().geometry,strip=g.recordStrip,boxes=Object.values(g.buttons);
        assert.equal(strip.h>0,expectedStrip);assert(strip.h*width/1080<=110,'strip exceeds 110 logical px');
        assert.equal(strip.y-strip.h/2,g.safeT,'strip starts below safe area');
        const regions=[...g.hud,g.play,...(strip.h?[strip]:[])];
        for(let i=0;i<regions.length;i++)for(const other of regions.slice(i+1))assert(!overlap(regions[i],other),'strip/HUD/play overlap');
        for(let i=0;i<boxes.length;i++){const box=boxes[i];
          assert(box.w*width/1080>=44-1e-9&&box.h*width/1080>=44-1e-9,'44pt targets');
          assert(box.y+box.h/2<=g.H-g.safeB&&box.y-box.h/2>=g.safeT,'control safe bounds');
          assert(box.x-box.w/2>=g.safeL&&box.x+box.w/2<=1080-g.safeR,'control horizontal bounds');
          if(['validation','yes','no'].some(key=>g.buttons[key]===box)){
            assert(box.y-box.h/2>=strip.y-strip.h/2&&box.y+box.h/2<=strip.y+strip.h/2,'record control inside strip');
          }
          for(const other of boxes.slice(i+1))assert(!overlap(box,other),'controls overlap');
          for(const other of [...g.hud,g.play])assert(!overlap(box,other),'control overlaps HUD/play');
          if(['bm','social'].some(key=>g.buttons[key]===box)&&strip.h)assert(!overlap(box,strip),'bottom control overlaps strip');
        }
      }
      layoutCheck(mode==='');
      if(mode===''){
        const initial=r.T.state().geometry;
        r.T.input('tap',initial.buttons.validation.x,initial.buttons.validation.y);
        assert(r.T.state().validation);layoutCheck(true); // 질문만 남음
        r.T.input('tap',initial.buttons.yes.x,initial.buttons.yes.y);layoutCheck(false);
        const other=runtime(width,height,'',st,sb);other.T.input('wanted',false);
        assert(other.T.state().geometry.recordStrip.h>0);other.T.input('validation');
        assert.equal(other.T.state().geometry.recordStrip.h,0);
      }
      assert.equal(r.canvas.width,width*2);assert.equal(r.canvas.height,height*2);assert(r.draws.length>0);
    }
  }
});
test('missing art reports failure and same-size silhouette; loaded PNG uses SPEC cell and pivot',()=>{
  const spec="[{file:'missing.png',cellW:32,cellH:32,displayW:80,displayH:90,pivotX:16,pivotY:32,cols:1,frames:1}]";
  const r=runtime(430,932,'?check',0,0,{}, {source:source.replace('const SPEC=[];',`const SPEC=${spec};`).replace("label(S('proto.tap'),", "sprite('missing',540,500);label(S('proto.tap'),")});
  assert.equal(r.T.assets().failed,1);assert(r.T.assets().silhouettes>0);assert.equal(r.T.check().ok,false);
  const png=Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aWQkAAAAASUVORK5CYII=','base64');
  const loaded=runtime(430,932,'?check',0,0,{}, {pngFiles:{'art/sprites/pixel.png':png},source:source
    .replace('const SPEC=[];',"const SPEC=[{file:'pixel.png',cellW:1,cellH:1,displayW:80,displayH:90,pivotX:.5,pivotY:1,cols:1,frames:1}];")
    .replace("label(S('proto.tap'),", "sprite('pixel',540,500);label(S('proto.tap'),")});
  loaded.draws.trace=true;loaded.T.step(0);assert.equal(loaded.T.assets().failed,0);assert.equal(loaded.T.assets().silhouettes,0);
  assert.deepEqual(Array.from(loaded.draws.images[0].args),[0,0,1,1,-40,-90,80,90]);assert(loaded.T.check().ok);
});
test('check in play mode restores records, effects, active ad and reward command',()=>{
  const r=runtime(430,932,'');play(r);r.T.input('tap');r.T.input('bm');r.T.step(2);const before=JSON.stringify(r.T.state()),writes=r.writes();
  assert(r.T.check().ok);assert.equal(JSON.stringify(r.T.state()),before);assert.equal(r.writes(),writes);
  r.T.step(3);assert.equal(r.T.state().ad,null);assert.equal(r.T.state().records.bm[0].completed,1);
});
test('BM ignored after 2s; ad blocks input for 5s, excludes play time, records acceptance',()=>{
  const r=runtime(430,932,'');play(r);r.T.input('tap');r.T.step(2);assert.equal(r.T.state().offer,null);assert(r.T.state().socialOffer);
  r.T.input('tap');r.T.input('bm');const before=r.T.state();r.T.input('tap');r.T.step(4.99);assert(r.T.state().ad);assert.equal(r.T.state().score,before.score);
  r.T.step(.01);assert.equal(r.T.state().ad,null);assert.equal(r.T.state().playTime,before.playTime);
  const metric=r.T.state().records.bm[0];assert.equal(metric.shown,2);assert.equal(metric.pressed,1);assert.equal(metric.completed,1);
});
test('duty is gated by validation; threshold-crossing round remains mandatory',()=>{
  const r=runtime(430,932,'');r.T.input('wanted',true);r.T.step(10);assert.equal(Object.values(r.T.state().records.dates)[0].active,0);
  r.T.input('validation');assert.equal(Object.values(r.T.state().records.dates)[0].wanted,true);
  r.T.step(301);r.T.input('tap');assert.equal(Object.values(r.T.state().records.dates)[0].voluntary,0);
  r.T.input('tap');assert.equal(Object.values(r.T.state().records.dates)[0].voluntary,1);
  assert.equal(r.T.state().records.loops.at(-1).voluntary,true);assert(Object.keys(r.storage).every(key=>key.startsWith(`proto_${r.T.state().proto}_`)));
});
test('fixed time steps and hidden-tab rAF pause without catch-up',()=>{
  const a=runtime(),b=runtime();a.T.step(1);for(let i=0;i<10;i++)b.T.step(.1);assert.equal(a.T.state().clock,b.T.state().clock);
  const r=runtime(430,932,'');play(r);r.frame(0);r.frame(100);const t=r.T.state().playTime;
  r.sandbox.document.hidden=true;r.documentListeners.visibilitychange();r.frame(60000);assert.equal(r.T.state().playTime,t);
  r.sandbox.document.hidden=false;r.documentListeners.visibilitychange();r.frame(70000);assert.equal(r.T.state().playTime,t);
  r.frame(70100);assert(r.T.state().playTime-t<.11);
});
test('pointer counts one completed tap, cancel and secondary pointers do not score',()=>{
  const r=runtime();const e=id=>({pointerId:id,clientX:150,clientY:300,preventDefault(){}});
  r.listeners.pointerdown(e(1));r.listeners.pointerdown(e(2));r.listeners.pointerup(e(2));assert.equal(r.T.state().score,0);
  r.listeners.pointerup(e(1));assert.equal(r.T.state().score,1);
  r.listeners.pointerdown(e(3));r.listeners.pointercancel();r.listeners.pointerup(e(3));assert.equal(r.T.state().score,1);
});
test('storage denied is safe; stats read-only, escaped, date/loop/BM/social tables',()=>{
  const r=runtime(430,932,'',0,0,{}, {storageThrows:true});play(r);r.T.input('tap');r.T.step(1);assert(r.T.check().ok);
  const stats=runtime(430,932,'?stats');assert.equal(stats.writes(),0);const markup=stats.elements.stats.innerHTML;
  for(const text of ['자발 판수','첫 입력 초','수락률','소셜','제작자 혼자의 판정, 편향 있음'])assert(markup.includes(text));
});
test('social has nine fixed neighbors, share download fallback and invitation hook',()=>{
  const r=runtime(430,932,'?scene=social&from=friend');assert.equal(r.T.state().neighbors.length,9);r.T.input('wanted',true);r.T.input('social');
  assert.equal(r.sandbox.downloads,1);const rows=r.T.state().records.social;assert(rows.some(row=>row.slot==='share'&&row.completed===1));assert.equal(r.T.state().from,'friend');
});
// 게임별 검사 — 새 게임에서는 이 예시만 해당 규칙의 검사로 교체한다.
test('example tap increases score and produces immediate reward drawing',()=>{
  const r=runtime();r.draws.trace=true;r.draws.ops=[];const before=r.T.state().score;r.T.input('tap',540,600);r.T.step(0);
  assert.equal(r.T.state().score,before+1);assert(r.draws.ops.filter(op=>op[0]==='arc').length>=24);
});
test('T exposes RULES state, fixed ticks, delayed events and isolated effect randomness',()=>{
  const a=runtime(430,932,'?check&scene=reward'),b=runtime();
  for(let i=0;i<5;i++){a.T.input('tap',300,600);b.T.input('tap',700,900);}
  assert.equal(JSON.stringify(a.T.state().rules),JSON.stringify(b.T.state().rules));
  assert.equal(a.T.state().rules.jobs[0].at,30);a.T.step(.5);
  assert.equal(a.T.state().rules.tick,30);assert.equal(a.T.state().rules.jobs.length,0);
  assert.equal(a.T.state().rules.rng,2463534242);
});
// 페이스 목표는 각 게임 DATA에 둔다. 빈 목표는 실패가 아닌 SKIP.
function paceFailures(result,targets){return Object.entries(targets).flatMap(([metric,target])=>{
  const value=result.metrics?.[metric];
  return Number.isFinite(value)&&Number.isFinite(target.min)&&Number.isFinite(target.max)&&value>=target.min&&value<=target.max?[]:
    [`${metric}: 값=${value} 목표=${target.min}~${target.max} why=${target.why}`];
});}
if(!Object.keys(data.pace??{}).length)console.log('SKIP 페이스: DATA.pace 비어 있음');
else test('페이스 (300초)',()=>{
  const failures=paceFailures(runtime().T.bot(300),data.pace);
  for(const line of failures)console.error('FAIL 페이스 '+line);
  assert.equal(failures.length,0,failures.join('\n'));
});
test('pace bot restores play/check/stats state, effects, pending pointer/ad and storage',()=>{
  for(const mode of ['', '?check', '?stats']){
    const r=runtime(430,932,mode);
    if(mode===''){play(r);r.T.input('tap');r.T.input('bm');r.T.step(2);}
    r.T.input('down',540,600);
    const before=JSON.stringify(r.T.state()),storage=JSON.stringify(r.storage),writes=r.writes(),tones=r.audio.tones;
    const result=r.T.bot(300);assert.equal(result.seconds,300);
    assert.equal(JSON.stringify(r.T.state()),before);assert.equal(JSON.stringify(r.storage),storage);assert.equal(r.writes(),writes);assert.equal(r.audio.tones,tones);
    assert.equal(result.metrics.scoresPerMinute,120);
    assert.throws(()=>r.T.bot(-1));assert.equal(JSON.stringify(r.T.state()),before);
    if(mode===''){r.T.step(3);assert.equal(r.T.state().ad,null);assert.equal(r.T.state().records.bm[0].completed,1);}
  }
  const r=runtime(430,932,'',0,0,{}, {source:source.replace('return {seconds,metrics:{scoresPerMinute:',"throw Error('bot fixture');return {seconds,metrics:{scoresPerMinute:")});
  const before=JSON.stringify(r.T.state()),writes=r.writes();assert.throws(()=>r.T.bot(1));
  assert.equal(JSON.stringify(r.T.state()),before);assert.equal(r.writes(),writes);
  assert.equal(paceFailures({metrics:{rate:0,other:20}},{rate:{min:1,max:2,why:'rare'},other:{min:3,max:4,why:'often'}}).length,2);
  assert.equal(paceFailures({metrics:{}},{missing:{min:1,max:2,why:'required'}}).length,1);
});
console.log(`${passed} checks passed; ${failed} failed. Real touch/audio/share need device verification.`);
if(failed)process.exitCode=1;

