 {file:'court.png',cellW:1024,cellH:1536,cols:1,frames:1,pivotX:0,pivotY:0,displayW:1080,displayH:1620,layer:'bg',required:true},
 ...['home','away'].map(key=>({file:key+'.png',cellW:256,cellH:256,cols:3,frames:9,pivotX:128,pivotY:233,displayW:150,displayH:150,layer:'actors',required:true})),
 {file:'ball.png',cellW:256,cellH:256,cols:1,frames:1,pivotX:128,pivotY:233,displayW:60,displayH:60,layer:'items',required:true}
];
// === RULES BEGIN ===
function rngInt(s,n){let x=s.rng;x"'^=x<<13;x>>>=0;x''^=x>>>17;x''^=x<<5;x>>>=0;s.rng=x;return x%n;}
const DIRECTIONS=[[10000,0],[9239,3827],[7071,7071],[3827,9239],[0,10000],[-3827,9239],[-7071,7071],[-9239,3827],[-10000,0],[-9239,-3827],[-7071,-7071],[-3827,-9239],[0,-10000],[3827,-9239],[7071,-7071],[9239,-3827]];
function resetPitch(s){const p=s.config.physics;
 s.players=s.config.players.map((v,i)=>({...v,id:i,r:p.playerRadius*v.radiusScale,m:p.playerMass,vx:0,vy:0,poseUntil:0}));
 s.ball={x:p.width/2,y:p.height/2,vx:0,vy:0,r:p.ballRadius,m:p.ballMass};
 s.wallHits=0;s.lastTouch=-1;s.lastTouchTick=-100;s.comboTick=-100;s.shooter=-1;s.contacts=[];
}
function endMatch(s,events){s.phase='"'end';s.winner=s.score[0]>s.score[1]?0:1;s.jobs=[{at:s.tick+s.config.physics.matchEndTicks,k:'nextMatch'}];
 const beaten=s.opponent;if(s.winner===0){s.stickers[beaten]=true;s.opponent=(beaten+1)%s.config.league.length;}
 events.push({k:'matchEnd',winner:s.winner,opponent:beaten,complete:s.stickers.every(v=>v)});
}
function nextTurn(s,events){if(s.turns>=s.config.physics.turnLimit){if(s.score[0]"'!==s.score[1]){endMatch(s,events);return;}s.suddenDeath=true;}
 s.team=1-s.team;enterAim(s,events);
}
function enterAim(s,events){s.phase='"'aim';if(s.team===1){s.phase='aiThink';aiTurn(s,events);}else events.push({k:'turn',team:0});}
function aiTurn(s,events){const cmd=aiPick(s,s.config.ai.level);s.rng=cmd.nextRng;s.pending=cmd;s.jobs=[{at:s.tick+s.config.physics.aiThinkTicks,k:'aiFlick'}];events.push({k:'thinking',who:cmd.who+3,team:1});}
function flick(s,cmd){const events=[],p=s.config.physics;
 if(s.phase"'!=='"'aim'||cmd.k"'!=='"'flick'||"'!Number.isInteger(cmd.who)||cmd.who<0||cmd.who>2||!Number.isFinite(cmd.dx)||!Number.isFinite(cmd.dy))return {events};
 const mag=Math.hypot(cmd.dx,cmd.dy);if(mag<p.minPull-0.01||mag>p.maxPull+0.01)return {events};
 const who=cmd.who+s.team*3,v=s.players[who];v.vx=cmd.dx*p.speedScale*v.power;v.vy=cmd.dy*p.speedScale*v.power;v.poseUntil=s.tick+6;
 s.shooter=who;s.turns++;s.phase='"'settle';s.wallHits=0;s.lastTouch=-1;s.lastTouchTick=-100;s.comboTick=-100;s.contacts=[];
 events.push({k:'flick',who,team:s.team});return {events};
}
function contact(s,a,b,events){let dx=b.x-a.x,dy=b.y-a.y;const dist=Math.hypot(dx,dy),reach=a.r+b.r;if(dist>=reach)return;
 if(dist===0){dx=1;dy=0;}const nx=dist?dx/dist:1,ny=dist?dy/dist:0,invA=1/a.m,invB=1/b.m;
 const overlap=reach-dist;a.x-=nx*overlap*invA/(invA+invB);a.y-=ny*overlap*invA/(invA+invB);b.x+=nx*overlap*invB/(invA+invB);b.y+=ny*overlap*invB/(invA+invB);
 const relative=(b.vx-a.vx)*nx+(b.vy-a.vy)*ny;if(relative>=0)return;
 const impulse=-(1+s.config.physics.restitution)*relative/(invA+invB);
 a.vx-=impulse*invA*nx;a.vy-=impulse*invA*ny;b.vx+=impulse*invB*nx;b.vy+=impulse*invB*ny;
 events.push({k:'contact',a:a.id??6,b:b.id??6,x:b.x,y:b.y});
 if(b===s.ball){
  // A teammate receives the moving ball and imparts a fresh impulse. The shot itself is not a pass.
  if(a.team===s.team&&a.id"'!==s.shooter&&(s.lastTouch===s.shooter||s.lastTouch>=0&&s.players[s.lastTouch].team===s.team||s.lastTouch===-1))s.comboTick=s.tick;
  else if(a.team!==s.team)s.comboTick=-100;
  s.lastTouch=a.id;s.lastTouchTick=s.tick;
 }
}
function walls(s,b,events){const p=s.config.physics;let bounced=false;
 if(b.x<b.r){b.x=b.r;if(b.vx<0){b.vx=-b.vx*p.wallRestitution;bounced=true;}}
 if(b.x>p.width-b.r){b.x=p.width-b.r;if(b.vx>0){b.vx=-b.vx*p.wallRestitution;bounced=true;}}
 const opening=b===s.ball&&b.x>=(p.width-p.goalWidth)/2&&b.x<=(p.width+p.goalWidth)/2;
 if(!opening||b!==s.ball){
  if(b.y<b.r){b.y=b.r;if(b.vy<0){b.vy=-b.vy*p.wallRestitution;bounced=true;}}
  if(b.y>p.height-b.r){b.y=p.height-b.r;if(b.vy>0){b.vy=-b.vy*p.wallRestitution;bounced=true;}}
 }
 if(bounced){if(b===s.ball)s.wallHits++;events.push({k:'"'bounce',x:b.x,y:b.y});}
}
function physicsTick(s){const events=[],p=s.config.physics,bodies=[...s.players,s.ball];
 // Four fixed substeps avoid tunnelling at maximum shot speed. Friction is applied once per tick.
 for(let sub=0;sub<4;sub++){
  for(const b of bodies){b.x+=b.vx/4;b.y+=b.vy/4;}
  for(let i=0;i<s.players.length;i++){for(let j=i+1;j<s.players.length;j++)contact(s,s.players[i],s.players[j],events);contact(s,s.players[i],s.ball,events);}
  for(const b of bodies)walls(s,b,events);
  const ball=s.ball;
  if(ball.y<0||ball.y>p.height){const team=ball.y<0?0:1;s.score[team]++;s.phase='reset';s.team=1-team;s.jobs=[{at:s.tick+p.resetTicks,k:'reset'}];
   events.push({k:'goal',team,x:ball.x,y:team===0?0:p.height});
   if(s.tick-s.comboTick<=2&&team===s.players[s.shooter]?.team){s.combos++;events.push({k:'combo',team});}
   if(s.wallHits>0)events.push({k:'bounceGoal',team});
   for(const v of s.players){v.poseUntil=s.tick+40;v.vx=0;v.vy=0;}ball.vx=0;ball.vy=0;ball.y=team===0?0:p.height;
   if(s.score[team]>=p.winningGoals||s.turns>=p.turnLimit&&s.score[0]"'!==s.score[1])endMatch(s,events);
   return {events,settled:true};
  }
 }
 let settled=true;for(const b of bodies){b.vx*=p.friction;b.vy*=p.friction;if(Math.hypot(b.vx,b.vy)<p.settleSpeed){b.vx=0;b.vy=0;}else settled=false;}
 return {events,settled};
}
function simulate(s,cmd,limit=600){const clone=JSON.parse(JSON.stringify(s));clone.phase='"'aim';clone.jobs=[];const events=flick(clone,cmd).events,trace=[];let ticks=0;
 if(clone.phase"'!=='"'settle')return {s:clone,events,trace,ticks};
 for(;ticks<Math.min(600,limit);){clone.tick++;ticks++;const out=physicsTick(clone);events.push(...out.events);
  if(limit<=60){const v=clone.players[clone.shooter];trace.push({x:v.x,y:v.y});if(out.events.some(e=>e.k==='contact'))break;}
  if(out.settled||clone.phase"'!=='"'settle')break;
 }
 return {s:clone,events,trace,ticks};
}
function aiScore(before,out){const team=before.team,enemy=1-team,p=before.config.physics,ball=out.s.ball,target=team===1?p.height:0;
 let score=(Math.hypot(before.ball.x-p.width/2,before.ball.y-target)-Math.hypot(ball.x-p.width/2,ball.y-target));
 for(const e of out.events)if(e.k==='goal')score+=e.team===team?1000:-2000;
 if(out.s.players.some(v=>v.team===team&&Math.hypot(v.x-ball.x,v.y-ball.y)<=100))score+=150;
 if(out.s.players.some(v=>v.team===enemy&&Math.hypot(v.x-ball.x,v.y-ball.y)<=120))score-=80;
 const keeper=out.s.players[team*3+2];if(Math.hypot(keeper.x-p.width/2,keeper.y-(team===1?0:p.height))>200)score-=120;
 return score;
}
function aiPick(s,level){const rand={rng:s.rng},candidates=[];
 for(let who=0;who<3;who++)for(const dir of DIRECTIONS){const pull=(6+rngInt(rand,31))*10,cmd={k:'flick',who,dx:dir[0]/10000*pull,dy:dir[1]/10000*pull};
  candidates.push({cmd,score:aiScore(s,simulate(s,cmd)),order:candidates.length});}
 candidates.sort((a,b)=>b.score-a.score||a.order-b.order);
 const count=level===1?24:level===2?10:1,index=rngInt(rand,count);
 return {...candidates[index].cmd,nextRng:rand.rng,candidates:48};
}
function randomPick(s){const who=rngInt(s,3),dir=DIRECTIONS[rngInt(s,16)],pull=(6+rngInt(s,31))*10;return {k:'flick',who,dx:dir[0]/10000*pull,dy:dir[1]/10000*pull};}
const RULES={
 init(data,seed){const s={config:JSON.parse(JSON.stringify({physics:data.physics,players:data.players,ai:data.ai,league:data.league})),tick:0,rng:(seed>>>0)||2463534242,round:1,jobs:[],score:[0,0],turns:0,team:0,phase:'aim',opponent:0,stickers:data.league.map(()=>false),suddenDeath:false,winner:-1,combos:0,pending:null};resetPitch(s);return s;},
 apply(s,cmd){return flick(s,cmd);},
 tick(s){s.tick++;let events=[];
  const due=s.jobs.filter(v=>v.at<=s.tick);s.jobs=s.jobs.filter(v=>v.at>s.tick);
  for(const job of due){if(job.k==='aiFlick'&&s.phase==='aiThink'){s.phase='aim';events.push(...flick(s,s.pending).events);s.pending=null;}
   else if(job.k==='reset'&&s.phase==='reset'){resetPitch(s);enterAim(s,events);events.push({k:'reset'});}
   else if(job.k==='nextMatch'&&s.phase==='end'){s.score=[0,0];s.turns=0;s.team=0;s.suddenDeath=false;s.winner=-1;s.round++;resetPitch(s);enterAim(s,events);events.push({k:'matchStart'});}
  }
  if(s.phase==='settle'){const out=physicsTick(s);events.push(...out.events);if(s.phase==='settle'&&out.settled)nextTurn(s,events);}
  return {events};
 }
};
// === RULES END ===
