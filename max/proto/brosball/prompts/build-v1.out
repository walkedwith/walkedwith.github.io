}
function sound(combo=false){if(inspecting||checkMode||statsMode)return;try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();audioCtx.resume();
 for(let i=0;i<(combo?3:1);i++){const osc=audioCtx.createOscillator(),gain=audioCtx.createGain(),t=audioCtx.currentTime+i*.08;osc.frequency.setValueAtTime(440*(1+i*.5),t);gain.gain.setValueAtTime(.0001,t);gain.gain.exponentialRampToValueAtTime(.12,t+.01);gain.gain.exponentialRampToValueAtTime(.0001,t+.2);osc.connect(gain);gain.connect(audioCtx.destination);osc.start(t);osc.stop(t+.22);}}catch(_){} }
function burst(x,y,count=30){for(let i=0;i<count;i++){const a=fxRandom()*Math.PI*2,speed=80+fxRandom()*300;fx.push({x,y,vx:Math.cos(a)*speed,vy:Math.sin(a)*speed-90,life:.8,size:5+fxRandom()*8});}}
function point(x,y){return {x:geom.court.x+x*geom.court.scale,y:geom.court.y+y*geom.court.scale};}
function present(result){for(const item of result.events){
 if(item.k==='goal'){const v=point(item.x,item.y);burst(v.x,v.y);shake=12;flash=.32;message=item.team===0?'골"'!'"':'상대 골"'!'"';messageUntil=game.clock+.7;sound();}
