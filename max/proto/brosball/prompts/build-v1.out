 RULES.tick(s);assert(s.ball.vx>0);for(let i=0;i<200;i++){RULES.tick(s);assert(s.ball.x>=24&&s.ball.x<=1056);assert(s.ball.y>=0&&s.ball.y<=1500);}
});
